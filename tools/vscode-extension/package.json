{
  "name": "merman-vscode",
  "displayName": "Merman",
  "description": "Local Mermaid authoring, diagnostics, preview, and export powered by Merman.",
  "version": "0.1.0",
  "publisher": "latias94",
  "preview": true,
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/Latias94/merman#readme",
  "bugs": {
    "url": "https://github.com/Latias94/merman/issues"
  },
  "qna": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/Latias94/merman.git"
  },
  "engines": {
    "vscode": "^1.121.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "mermaid",
    "diagram",
    "preview",
    "lsp",
    "diagnostics",
    "export",
    "markdown",
    "mdx"
  ],
  "galleryBanner": {
    "color": "#0B3D3A",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:mermaid",
    "onLanguage:markdown",
    "onLanguage:mdx",
    "onCommand:merman.restartLanguageServer",
    "onCommand:merman.openPreview",
    "onCommand:merman.togglePreviewLock",
    "onCommand:merman.refreshPreview",
    "onCommand:merman.showPreviewSource",
    "onCommand:merman.export",
    "onCommand:merman.exportSvg",
    "onCommand:merman.exportPng",
    "onCommand:merman.copySvg",
    "onCommand:merman.copyPng",
    "onCommand:merman.showRuleCatalog",
    "onCommand:merman.showConfigSchema",
    "workspaceContains:**/*.mmd",
    "workspaceContains:**/*.mermaid"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Preview, export, and packaged language intelligence are available in Restricted Mode. Custom executable paths, custom launch arguments, and Cargo-run development settings require Workspace Trust."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "mermaid",
        "aliases": [
          "Mermaid",
          "mermaid"
        ],
        "extensions": [
          ".mmd",
          ".mermaid"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "mermaid",
        "path": "./snippets/mermaid.json"
      }
    ],
    "configuration": [
      {
        "title": "Merman: Runtime",
        "properties": {
          "merman.server.path": {
            "type": "string",
            "default": "",
            "restricted": true,
            "markdownDescription": "Optional absolute path to a prebuilt `merman-lsp` executable. Leave empty to use the packaged binary. Configured executables require workspace trust.",
            "scope": "machine-overridable",
            "order": 10
          },
          "merman.server.args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "restricted": true,
            "markdownDescription": "Additional arguments appended when launching `merman-lsp` directly. Requires Workspace Trust because this is a restricted setting.",
            "scope": "machine-overridable",
            "order": 20
          },
          "merman.cli.path": {
            "type": "string",
            "default": "",
            "restricted": true,
            "markdownDescription": "Optional absolute path to a prebuilt `merman-cli` executable used for local preview and export. Leave empty to use the packaged binary. Configured executables require workspace trust.",
            "scope": "machine-overridable",
            "order": 30
          }
        }
      },
      {
        "title": "Merman: Language Intelligence",
        "properties": {
          "merman.languageIntelligence.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Start the local `merman-lsp` language server for completion, hover, symbols, references, rename, semantic tokens, diagnostics, and quick fixes. Disable this when using the extension only for preview and export.",
            "scope": "window",
            "order": 10
          },
          "merman.diagnostics.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Publish Merman diagnostics to VS Code Problems. Disable this when another Mermaid or Markdown linter owns diagnostics; Merman completion, hover, symbols, references, rename, semantic tokens, preview, and export remain available.",
            "scope": "window",
            "order": 20
          },
          "merman.trace.server": {
            "type": "string",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "default": "off",
            "markdownDescription": "LSP trace level forwarded to the VS Code language client.",
            "scope": "window",
            "enumDescriptions": [
              "Disable LSP tracing.",
              "Trace LSP protocol messages.",
              "Trace LSP protocol messages with verbose payload detail."
            ],
            "order": 30
          }
        }
      },
      {
        "title": "Merman: Analysis",
        "properties": {
          "merman.analysis.fixed_today": {
            "type": "string",
            "markdownDescription": "Optional canonical deterministic local civil date forwarded to `merman-lsp`. Leave unset to use the connected server's default. Years 0000 through 9999 use `YYYY-MM-DD`; later years use `+YEAR-MM-DD`, and negative years use `-YEAR-MM-DD`. The date and its local-midnight instant are validated when the configuration is applied.",
            "scope": "window",
            "order": 10,
            "pattern": "^(?:\\d{4}|\\+(?:[1-9]\\d{4,8}|1\\d{9}|20\\d{8}|21[0-3]\\d{7}|214[0-6]\\d{6}|2147[0-3]\\d{5}|21474[0-7]\\d{4}|214748[0-2]\\d{3}|2147483[0-5]\\d{2}|21474836[0-3]\\d|214748364[0-7])|-(?:000[1-9]|00[1-9]\\d|0[1-9]\\d{2}|[1-9]\\d{3}|[1-9]\\d{4,8}|1\\d{9}|20\\d{8}|21[0-3]\\d{7}|214[0-6]\\d{6}|2147[0-3]\\d{5}|21474[0-7]\\d{4}|214748[0-2]\\d{3}|2147483[0-5]\\d{2}|21474836[0-3]\\d|214748364[0-8]))-\\d{2}-\\d{2}$"
          },
          "merman.analysis.fixed_local_offset_minutes": {
            "type": [
              "integer",
              "null"
            ],
            "markdownDescription": "Optional deterministic local UTC offset in minutes forwarded to `merman-lsp` analysis options. Leave unset or set `null` to use the connected server's default.",
            "scope": "window",
            "order": 20,
            "minimum": -1439,
            "maximum": 1439
          },
          "merman.analysis.site_config": {
            "type": "object",
            "markdownDescription": "Optional Mermaid site configuration object forwarded to `merman-lsp` analysis options. Leave unset to use the connected server's default.",
            "scope": "window",
            "order": 30
          },
          "merman.analysis.resources.limits.max_source_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "markdownDescription": "Optional source size cap forwarded to `merman-lsp`. Leave unset or set `null` to use the connected server's default.",
            "scope": "window",
            "order": 40,
            "minimum": 1,
            "maximum": 4294967295
          },
          "merman.analysis.resources.limits.max_document_diagrams": {
            "type": [
              "integer",
              "null"
            ],
            "markdownDescription": "Optional Mermaid fence count cap for Markdown and MDX documents. Leave unset or set `null` to use the connected server's default; `0` rejects documents containing any Mermaid diagram.",
            "scope": "window",
            "order": 41,
            "minimum": 0,
            "maximum": 4294967295
          },
          "merman.analysis.lint.profile": {
            "type": "string",
            "markdownDescription": "Lint profile forwarded to `merman-lsp`. Leave unset to use the connected server's default profile.",
            "scope": "window",
            "order": 50,
            "examples": [
              "core",
              "recommended",
              "strict"
            ]
          },
          "merman.analysis.lint.enable_rules": {
            "type": "array",
            "items": {
              "type": "string",
              "examples": [
                "merman.authoring.config.prefer_init_directive",
                "merman.authoring.config.prefer_frontmatter_config",
                "merman.compatibility.config.deprecated_flowchart_html_labels",
                "merman.compatibility.config.deprecated_external_diagram_loading",
                "merman.parse.no_diagram",
                "merman.parse.diagram_parse",
                "merman.compatibility.unsupported_diagram",
                "merman.parse.recovered_editor_facts",
                "merman.config.malformed_front_matter",
                "merman.config.invalid_directive_json",
                "merman.config.invalid_front_matter_yaml",
                "merman.config.invalid_theme_color",
                "merman.block.width_exceeds_columns",
                "merman.authoring.flowchart.explicit_direction",
                "merman.semantic.flowchart.unknown_style_target",
                "merman.git_graph.duplicate_commit_id"
              ]
            },
            "markdownDescription": "Additional lint rules enabled in `merman-lsp`.",
            "scope": "window",
            "order": 60
          },
          "merman.analysis.lint.disable_rules": {
            "type": "array",
            "items": {
              "type": "string",
              "examples": [
                "merman.authoring.config.prefer_init_directive",
                "merman.authoring.config.prefer_frontmatter_config",
                "merman.compatibility.config.deprecated_flowchart_html_labels",
                "merman.compatibility.config.deprecated_external_diagram_loading",
                "merman.parse.no_diagram",
                "merman.parse.diagram_parse",
                "merman.compatibility.unsupported_diagram",
                "merman.parse.recovered_editor_facts",
                "merman.config.malformed_front_matter",
                "merman.config.invalid_directive_json",
                "merman.config.invalid_front_matter_yaml",
                "merman.config.invalid_theme_color",
                "merman.block.width_exceeds_columns",
                "merman.authoring.flowchart.explicit_direction",
                "merman.semantic.flowchart.unknown_style_target",
                "merman.git_graph.duplicate_commit_id"
              ]
            },
            "markdownDescription": "Lint rules disabled in `merman-lsp`.",
            "scope": "window",
            "order": 70
          },
          "merman.analysis.lint.rule_severities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rule_id": {
                  "type": "string",
                  "examples": [
                    "merman.authoring.config.prefer_init_directive",
                    "merman.authoring.config.prefer_frontmatter_config",
                    "merman.compatibility.config.deprecated_flowchart_html_labels",
                    "merman.compatibility.config.deprecated_external_diagram_loading",
                    "merman.parse.no_diagram",
                    "merman.parse.diagram_parse",
                    "merman.compatibility.unsupported_diagram",
                    "merman.parse.recovered_editor_facts",
                    "merman.config.malformed_front_matter",
                    "merman.config.invalid_directive_json",
                    "merman.config.invalid_front_matter_yaml",
                    "merman.config.invalid_theme_color",
                    "merman.block.width_exceeds_columns",
                    "merman.authoring.flowchart.explicit_direction",
                    "merman.semantic.flowchart.unknown_style_target",
                    "merman.git_graph.duplicate_commit_id"
                  ]
                },
                "severity": {
                  "type": "string",
                  "examples": [
                    "error",
                    "warning",
                    "info",
                    "hint"
                  ]
                }
              },
              "required": [
                "rule_id",
                "severity"
              ]
            },
            "markdownDescription": "Per-rule severity overrides forwarded to `merman-lsp`.",
            "scope": "window",
            "order": 80
          }
        }
      },
      {
        "title": "Merman: Preview and Export",
        "properties": {
          "merman.sourceActions.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Show Merman source-scoped CodeLens actions above `.mmd` files and Markdown/MDX Mermaid fences. Disable this when another preview/export extension owns those editor actions.",
            "scope": "resource",
            "order": 10
          },
          "merman.preview.diagramTheme": {
            "type": "string",
            "enum": [
              "source",
              "default",
              "dark",
              "forest",
              "neutral",
              "base"
            ],
            "enumDescriptions": [
              "Use the Mermaid source or default render theme selected by Merman.",
              "Use Mermaid default theme.",
              "Use Mermaid dark theme.",
              "Use Mermaid forest theme.",
              "Use Mermaid neutral theme.",
              "Use Mermaid base theme."
            ],
            "default": "source",
            "scope": "window",
            "order": 20,
            "markdownDescription": "Default diagram theme for new Merman preview panels. The preview toolbar can override this for the current panel session."
          },
          "merman.preview.displayMode": {
            "type": "string",
            "enum": [
              "svg",
              "ascii",
              "unicode"
            ],
            "enumDescriptions": [
              "Render SVG preview output.",
              "Render ASCII text preview output.",
              "Render Unicode text preview output."
            ],
            "default": "svg",
            "scope": "window",
            "order": 30,
            "markdownDescription": "Default display mode for new Merman preview panels. The preview toolbar can override this for the current panel session."
          },
          "merman.preview.background": {
            "type": "string",
            "enum": [
              "paper",
              "transparent",
              "dark"
            ],
            "enumDescriptions": [
              "Use the default paper preview background.",
              "Use a transparent preview background.",
              "Use a dark preview background."
            ],
            "default": "paper",
            "scope": "window",
            "order": 40,
            "markdownDescription": "Default background for new Merman preview panels and exported preview renders. The preview toolbar can override this for the current panel session."
          }
        }
      },
      {
        "title": "Merman: Development",
        "properties": {
          "merman.server.useCargoRun": {
            "type": "boolean",
            "default": false,
            "restricted": true,
            "markdownDescription": "Development only: launch `merman-lsp` through `cargo run -p merman-lsp --` instead of the packaged binary. Requires workspace trust.",
            "scope": "machine-overridable",
            "order": 10
          },
          "merman.server.cargoArgs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "restricted": true,
            "markdownDescription": "Development only: extra Cargo arguments inserted before `--` when launching `merman-lsp` through Cargo. Requires Workspace Trust because this is a restricted setting.",
            "scope": "machine-overridable",
            "order": 20
          },
          "merman.cli.useCargoRun": {
            "type": "boolean",
            "default": false,
            "restricted": true,
            "markdownDescription": "Development only: launch `merman-cli` through `cargo run -p merman-cli --` instead of the packaged binary. Requires workspace trust.",
            "scope": "machine-overridable",
            "order": 30
          },
          "merman.cli.cargoArgs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "restricted": true,
            "markdownDescription": "Development only: extra Cargo arguments inserted before `--` when launching `merman-cli` through Cargo. Requires Workspace Trust because this is a restricted setting.",
            "scope": "machine-overridable",
            "order": 40
          }
        }
      }
    ],
    "commands": [
      {
        "command": "merman.restartLanguageServer",
        "title": "Merman: Restart Language Server"
      },
      {
        "command": "merman.openPreview",
        "title": "Merman: Open Preview",
        "category": "Merman",
        "icon": "$(open-preview)"
      },
      {
        "command": "merman.togglePreviewLock",
        "title": "Merman: Toggle Preview Lock",
        "category": "Merman",
        "icon": "$(lock)"
      },
      {
        "command": "merman.refreshPreview",
        "title": "Merman: Refresh Preview",
        "category": "Merman",
        "icon": "$(refresh)"
      },
      {
        "command": "merman.showPreviewSource",
        "title": "Merman: Show Preview Source",
        "category": "Merman",
        "icon": "$(go-to-file)"
      },
      {
        "command": "merman.export",
        "title": "Merman: Export...",
        "category": "Merman",
        "icon": "$(export)"
      },
      {
        "command": "merman.exportSvg",
        "title": "Merman: Export SVG",
        "category": "Merman",
        "icon": "$(export)"
      },
      {
        "command": "merman.exportPng",
        "title": "Merman: Export PNG",
        "category": "Merman",
        "icon": "$(file-media)"
      },
      {
        "command": "merman.copySvg",
        "title": "Merman: Copy SVG",
        "category": "Merman",
        "icon": "$(copy)"
      },
      {
        "command": "merman.copyPng",
        "title": "Merman: Copy PNG",
        "category": "Merman",
        "icon": "$(file-media)"
      },
      {
        "command": "merman.showRuleCatalog",
        "title": "Merman: Show Rule Catalog",
        "category": "Merman"
      },
      {
        "command": "merman.showConfigSchema",
        "title": "Merman: Show Config Schema",
        "category": "Merman"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "merman.openPreview",
          "when": "resourceLangId == mermaid || resourceLangId == markdown || resourceLangId == mdx",
          "group": "navigation@10"
        },
        {
          "command": "merman.export",
          "when": "resourceLangId == mermaid || resourceLangId == markdown || resourceLangId == mdx",
          "group": "navigation@11"
        },
        {
          "command": "merman.exportSvg",
          "when": "resourceLangId == mermaid || resourceLangId == markdown || resourceLangId == mdx",
          "group": "navigation@12"
        }
      ],
      "editor/context": [
        {
          "command": "merman.openPreview",
          "when": "resourceLangId == mermaid || resourceLangId == markdown || resourceLangId == mdx",
          "group": "navigation@10"
        },
        {
          "command": "merman.export",
          "when": "resourceLangId == mermaid || resourceLangId == markdown || resourceLangId == mdx",
          "group": "navigation@11"
        },
        {
          "command": "merman.exportSvg",
          "when": "resourceLangId == mermaid || resourceLangId == markdown || resourceLangId == mdx",
          "group": "navigation@12"
        },
        {
          "command": "merman.exportPng",
          "when": "resourceLangId == mermaid || resourceLangId == markdown || resourceLangId == mdx",
          "group": "navigation@13"
        },
        {
          "command": "merman.copySvg",
          "when": "resourceLangId == mermaid || resourceLangId == markdown || resourceLangId == mdx",
          "group": "navigation@14"
        },
        {
          "command": "merman.copyPng",
          "when": "(resourceLangId == mermaid || resourceLangId == markdown || resourceLangId == mdx) && merman.pngClipboardAvailable",
          "group": "navigation@15"
        }
      ],
      "explorer/context": [
        {
          "command": "merman.openPreview",
          "when": "resourceExtname == .mmd || resourceExtname == .mermaid || resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdx",
          "group": "navigation@10"
        },
        {
          "command": "merman.export",
          "when": "resourceExtname == .mmd || resourceExtname == .mermaid || resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdx",
          "group": "navigation@11"
        },
        {
          "command": "merman.exportSvg",
          "when": "resourceExtname == .mmd || resourceExtname == .mermaid || resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdx",
          "group": "navigation@12"
        },
        {
          "command": "merman.exportPng",
          "when": "resourceExtname == .mmd || resourceExtname == .mermaid || resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdx",
          "group": "navigation@13"
        }
      ],
      "commandPalette": [
        {
          "command": "merman.openPreview",
          "when": "resourceLangId == mermaid || resourceLangId == markdown || resourceLangId == mdx"
        },
        {
          "command": "merman.refreshPreview"
        },
        {
          "command": "merman.showPreviewSource"
        },
        {
          "command": "merman.export",
          "when": "resourceLangId == mermaid || resourceLangId == markdown || resourceLangId == mdx"
        },
        {
          "command": "merman.exportSvg",
          "when": "resourceLangId == mermaid || resourceLangId == markdown || resourceLangId == mdx"
        },
        {
          "command": "merman.exportPng",
          "when": "resourceLangId == mermaid || resourceLangId == markdown || resourceLangId == mdx"
        },
        {
          "command": "merman.copySvg",
          "when": "resourceLangId == mermaid || resourceLangId == markdown || resourceLangId == mdx"
        },
        {
          "command": "merman.copyPng",
          "when": "(resourceLangId == mermaid || resourceLangId == markdown || resourceLangId == mdx) && merman.pngClipboardAvailable"
        }
      ]
    },
    "semanticTokenTypes": [
      {
        "id": "mermanDelimiter",
        "superType": "operator",
        "description": "Punctuation that delimits Mermaid syntax."
      },
      {
        "id": "mermanIdentifier",
        "superType": "variable",
        "description": "A parser-backed Mermaid identifier."
      },
      {
        "id": "mermanDate",
        "superType": "number",
        "description": "A Mermaid date literal."
      },
      {
        "id": "mermanDuration",
        "superType": "number",
        "description": "A Mermaid duration literal."
      },
      {
        "id": "mermanBoolean",
        "superType": "keyword",
        "description": "A Mermaid boolean literal."
      },
      {
        "id": "mermanStyle",
        "superType": "string",
        "description": "A Mermaid style expression."
      },
      {
        "id": "mermanColor",
        "superType": "string",
        "description": "A Mermaid color literal."
      },
      {
        "id": "mermanLiteral",
        "superType": "string",
        "description": "An unquoted Mermaid literal."
      },
      {
        "id": "mermanFrontmatter",
        "superType": "string",
        "description": "A Mermaid YAML frontmatter block."
      },
      {
        "id": "mermanDirective",
        "superType": "keyword",
        "description": "A Mermaid initialization directive."
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "mermanReference",
        "description": "Marks a parser-backed reference to a Mermaid entity."
      },
      {
        "id": "mermanEntity",
        "description": "Marks a parser-backed Mermaid semantic entity."
      },
      {
        "id": "mermanOutline",
        "description": "Marks parser-backed Mermaid outline structure."
      },
      {
        "id": "mermanPayload",
        "description": "Marks parser-backed Mermaid payload data."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "mermaid",
        "scopes": {
          "mermanDelimiter": [
            "punctuation.definition.mermaid",
            "punctuation.separator.mermaid"
          ],
          "mermanIdentifier": [
            "variable.other.readwrite.mermaid",
            "entity.name.variable.mermaid"
          ],
          "mermanDate": [
            "constant.numeric.date.mermaid",
            "constant.numeric"
          ],
          "mermanDuration": [
            "constant.numeric.duration.mermaid",
            "constant.numeric"
          ],
          "mermanBoolean": [
            "constant.language.boolean.mermaid",
            "constant.language.boolean"
          ],
          "mermanStyle": [
            "meta.embedded.inline.css.mermaid",
            "string.unquoted.mermaid"
          ],
          "mermanColor": [
            "constant.other.color.mermaid",
            "constant.other.color"
          ],
          "mermanLiteral": [
            "string.unquoted.mermaid",
            "string.unquoted"
          ],
          "mermanFrontmatter": [
            "meta.embedded.block.frontmatter.mermaid",
            "string.unquoted.mermaid"
          ],
          "mermanDirective": [
            "meta.preprocessor.mermaid",
            "keyword.control.directive.mermaid"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[mermaid]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "build": "npm run licenses:check && npm run clean && npm run compile && npm run bundle",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "compile": "tsc -p .",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node22 --external:vscode --outfile=dist/extension.js --sourcemap --sources-content=false --legal-comments=external",
    "check": "tsc -p . --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/**/*.test.js scripts/*.test.mjs",
    "test:extension-host": "npm run build && node scripts/run-extension-host-smoke.mjs",
    "prepare:binaries": "node scripts/prepare-binaries.mjs",
    "package": "npm run build && node scripts/package-vsix.mjs",
    "verify:vsix": "node scripts/verify-vsix.mjs",
    "smoke:vsix": "node scripts/smoke-vsix.mjs",
    "licenses:check": "node ../../scripts/generate-npm-license-report.mjs --package-root tools/vscode-extension --output tools/vscode-extension/THIRD_PARTY_LICENSES/npm-production-dependencies.txt --check",
    "licenses:generate": "node ../../scripts/generate-npm-license-report.mjs --package-root tools/vscode-extension --output tools/vscode-extension/THIRD_PARTY_LICENSES/npm-production-dependencies.txt --write"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.0"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "@types/vscode": "1.120.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "generate-license-file": "4.2.1",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.0.9": true,
    "esbuild@0.28.1": true,
    "keytar@7.9.0": true
  }
}
