  "minimum_semantics": [
    {
      "id": "written-results-own-nonzero-allocation-tokens",
      "description": "Any producing call that writes Merman-owned result bytes writes a process-lifetime monotonic nonzero allocation_token; token exhaustion returns internal-error and leaves a caller-valid zero-initialized result unchanged."
    },
    {
      "id": "result-free-authorizes-by-token-and-clears-the-record",
      "description": "result_free authorizes release solely by a live allocation_token, never by buffer pointers; zero, unknown, stale, or random non-live tokens release nothing, and every call clears the complete supplied result record before releasing the token allocation."
    },
    {
      "id": "engine-try-close-is-nonblocking-and-success-is-quiescent",
      "description": "engine_try_close never waits: callback-active returns reentrant-call, another active operation returns busy with the token still valid, and quiescent success closes admission, retires the token, and guarantees callback and user_data quiescence."
    },
    {
      "id": "host-callback-nonlocal-exits-are-forbidden",
      "description": "Host callbacks are synchronous and MUST NOT unwind, throw, propagate SEH, call longjmp, or otherwise perform a non-local exit across the ABI boundary; Merman converts only returned status values and cannot catch foreign exceptions."
    },
    {
      "id": "engine-new-inputs-and-outputs-do-not-overlap",
      "description": "For engine_new, the config record, its options_json storage, out_engine storage, and out_result storage MUST be pairwise non-overlapping, and out_engine must be initialized to zero."
    },
    {
      "id": "error-kind-vocabulary-is-closed",
      "description": "The ABI 3 error-kind vocabulary is exactly generic, unknown-operation, missing-capability, reentrant-call, and busy; adding, removing, or renaming an error kind requires a new ABI version."
    },
    {
      "id": "api-table-capacity-returns-complete-prefix",
      "description": "Discovery treats MermanNativeApi.struct_size as input capacity and returns only the largest complete producer prefix safely initialized within that capacity; it never exposes a partial appended slot, and the returned size is safe to reuse as capacity for another discovery call."
    },
    {
      "id": "moved-result-record-transfers-token-ownership",
      "description": "Moving the complete MermanNativeResult record transfers its live allocation_token ownership; result_free clears the supplied record before releasing the token allocation, so the moved record may reside inside Merman-owned result storage."
    },
    {
      "id": "input-and-callback-slices-are-borrowed",
      "description": "Input, media-type, and callback slices are borrowed; hosts MUST NOT retain their pointers after the enclosing call or callback returns."
    },
    {
      "id": "callback-state-is-constructor-owned-until-quiescent-close",
      "description": "Callback and user_data are immutable constructor-owned engine state, remain valid until successful quiescent engine_try_close, and may be released only after that close succeeds."
    }
  ],
