// State diagram grammar (phase 1), based on Mermaid 11.12.2 `stateDiagram.jison`.

grammar(document: &mut StateDocument);

use crate::diagrams::state::{StateStatementClick, StateStatementNote, StateStatementRelation, StateStatementState, StateStatement, StateDocument, StateDocumentId, Tok};
use crate::SourceSpan;

extern {
  type Location = usize;
  type Error = crate::diagrams::state::LexError;

  enum Tok {
    Newline => Tok::Newline,

    "stateDiagram" => Tok::Sd,

    Id => Tok::Id(<String>),
    StyledId => Tok::StyledId(<(String, String)>),
    EdgeState => Tok::EdgeState,
    Descr => Tok::Descr(<String>),
    "-->" => Tok::Arrow,
    "{" => Tok::StructStart,
    "}" => Tok::StructStop,
    "as" => Tok::As,
    Note => Tok::Note,
    LeftOf => Tok::LeftOf,
    RightOf => Tok::RightOf,
    NoteTextTok => Tok::NoteText(<String>),

    StateDescr => Tok::StateDescr(<String>),
    CompositState => Tok::CompositState(<String>),
    Fork => Tok::Fork(<String>),
    Join => Tok::Join(<String>),
    Choice => Tok::Choice(<String>),
    Concurrent => Tok::Concurrent,
    HideEmptyDescription => Tok::HideEmptyDescription,
    ScaleWidth => Tok::ScaleWidth(<usize>),

    ClassDef => Tok::ClassDef,
    ClassDefId => Tok::ClassDefId(<String>),
    ClassDefStyleOpts => Tok::ClassDefStyleOpts(<String>),

    Class => Tok::Class,
    ClassEntityIds => Tok::ClassEntityIds(<String>),
    StyleClass => Tok::StyleClass(<String>),

    Style => Tok::Style,
    StyleIds => Tok::StyleIds(<String>),
    StyleDefStyleOpts => Tok::StyleDefStyleOpts(<String>),

    Direction => Tok::Direction(<crate::diagrams::state::SpannedDirection>),
    AccTitle => Tok::AccTitle(<String>),
    AccDescr => Tok::AccDescr(<String>),
    AccDescrMultiline => Tok::AccDescrMultiline(<String>),

    Click => Tok::Click,
    Href => Tok::Href,
    StringLit => Tok::StringLit(<String>),
  }
}

pub Root: StateDocumentId = {
  <_p:Prelude> "stateDiagram" <items:Items> => document.push(items),
};

Prelude: () = {
  => (),
  Newline <rest:Prelude> => rest,
};

Items: Vec<StateStatement> = {
  <items:(Item)*> => items.into_iter().filter_map(|i| i).collect()
};

Item: Option<StateStatement> = {
  Newline => None,
  <s:Statement> => Some(s),
};

Statement: StateStatement = {
  <s:ClassDefStatement> => s,
  <s:StyleStatement> => s,
  <s:CssClassStatement> => s,
  <s:DirectionStatement> => s,
  <s:AccessibilityStatement> => s,
  <s:ClickStatement> => s,
  <s:NoteStatement> => s,
  HideEmptyDescription => StateStatement::Noop,
  ScaleWidth => StateStatement::Noop,

  <s1:IdStatement> "-->" <s2:IdStatement> <d:OptDescr> => StateStatement::Relation(Box::new(StateStatementRelation {
    state1: s1,
    state2: s2,
    description: d,
  })),

  <mut s:IdStatement> <d:OptDescr> => {
    s.description = d;
    StateStatement::State(s)
  },

  // `state <id>` without a `{ ... }` is effectively a no-op in Mermaid's parser.
  <_id:CompositState> => StateStatement::Noop,

  <l:@L> <id:CompositState> <r:@R> <doc:Block> => StateStatement::State(StateStatementState {
    id,
    id_span: Some(SourceSpan::new(l, r)),
    ty: "default".to_string(),
    description: None,
    descriptions: Vec::new(),
    doc: Some(doc),
    note: None,
    classes: Vec::new(),
    styles: Vec::new(),
    text_styles: Vec::new(),
    start: None,
  }),

  <descr:StateDescr> "as" <l:@L> <id:Id> <doc:OptBlock> => {
    let trimmed = descr.trim().to_string();
    let mut state_id = id;
    let mut id_span = Some(SourceSpan::new(l, l + state_id.len()));
    let description = trimmed;
    let mut descriptions: Vec<String> = Vec::new();
    if let Some((a, b)) = state_id
      .split_once(':')
      .map(|(a, b)| (a.to_string(), b.to_string())) {
      id_span = Some(SourceSpan::new(l, l + a.len()));
      state_id = a;
      let extra = b.trim();
      if !extra.is_empty() {
        descriptions.push(extra.to_string());
      }
    }
    StateStatement::State(StateStatementState {
      id: state_id,
      id_span,
      ty: "default".to_string(),
      description: Some(description),
      descriptions,
      doc,
      note: None,
      classes: Vec::new(),
      styles: Vec::new(),
      text_styles: Vec::new(),
      start: None,
    })
  },

  <l:@L> <id:Fork> => {
    let mut state = StateStatementState::new_typed(id, "fork");
    state.id_span = Some(SourceSpan::new(l, l + state.id.len()));
    StateStatement::State(state)
  },
  <l:@L> <id:Join> => {
    let mut state = StateStatementState::new_typed(id, "join");
    state.id_span = Some(SourceSpan::new(l, l + state.id.len()));
    StateStatement::State(state)
  },
  <l:@L> <id:Choice> => {
    let mut state = StateStatementState::new_typed(id, "choice");
    state.id_span = Some(SourceSpan::new(l, l + state.id.len()));
    StateStatement::State(state)
  },
  Concurrent => StateStatement::State(StateStatementState::new_typed("__divider__".to_string(), "divider")),
};

NoteStatement: StateStatement = {
  Note <pos:NotePosition> <l:@L> <id:Id> <r:@R> <text:NoteTextTok> => StateStatement::State(StateStatementState {
    id,
    id_span: Some(SourceSpan::new(l, r)),
    ty: "default".to_string(),
    description: None,
    descriptions: Vec::new(),
    doc: None,
    note: Some(StateStatementNote { position: Some(pos), text }),
    classes: Vec::new(),
    styles: Vec::new(),
    text_styles: Vec::new(),
    start: None,
  }),
  // Mermaid `@11.12.2` accepts the floating note syntax, but it does not participate in the state
  // diagram model (see upstream `stateDiagram floating notes` specs). Treat it as a no-op.
  //
  // Note: downstream relations can still reference the note id; in that case Mermaid will render a
  // regular state node for that id (the note text is ignored).
  Note <_text:NoteTextTok> "as" <_id:Id> => StateStatement::Noop,
};

NotePosition: String = {
  LeftOf => "left of".to_string(),
  RightOf => "right of".to_string(),
};

OptDescr: Option<String> = {
  => None,
  <d:Descr> => Some(d),
};

Block: StateDocumentId = {
  "{" <doc:Items> "}" => document.push(doc)
};

OptBlock: Option<StateDocumentId> = {
  => None,
  <b:Block> => Some(b),
};

ClassDefStatement: StateStatement = {
  ClassDef <id:ClassDefId> <raw:ClassDefStyleOpts> => StateStatement::ClassDef { id, classes: raw },
};

StyleStatement: StateStatement = {
  Style <ids:StyleIds> <raw:StyleDefStyleOpts> => StateStatement::Style { ids, styles: raw },
};

CssClassStatement: StateStatement = {
  Class <ids:ClassEntityIds> <style:StyleClass> => StateStatement::ApplyClass { ids, class_name: style },
};

DirectionStatement: StateStatement = {
  <d:Direction> => StateStatement::Direction(d.value),
};

AccessibilityStatement: StateStatement = {
  <t:AccTitle> => StateStatement::AccTitle(t),
  <d:AccDescr> => StateStatement::AccDescr(d),
  <d:AccDescrMultiline> => StateStatement::AccDescr(d),
};

ClickStatement: StateStatement = {
  Click <s:IdStatement> <url:StringLit> <tooltip:StringLit> => StateStatement::Click(StateStatementClick {
    id: s.id,
    url,
    tooltip,
  }),
  Click <s:IdStatement> Href <url:StringLit> => StateStatement::Click(StateStatementClick {
    id: s.id,
    url,
    tooltip: String::new(),
  }),
};

IdStatement: StateStatementState = {
  <l:@L> <id:Id> <r:@R> => {
    let mut state = StateStatementState::new(id);
    state.id_span = Some(SourceSpan::new(l, r));
    state
  },
  <l:@L> EdgeState <r:@R> => {
    let mut state = StateStatementState::new("[*]".to_string());
    state.id_span = Some(SourceSpan::new(l, r));
    state
  },
  <l:@L> <pair:StyledId> => {
    let (id, class_id) = pair;
    let mut s = StateStatementState::new(id);
    s.id_span = Some(SourceSpan::new(l, l + s.id.len()));
    s.classes.push(class_id);
    s
  }
};
