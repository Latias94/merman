{
  "schema_version": 2,
  "purpose": "Pinned exact and N-1 accounting boundaries for public ASCII transports.",
  "update_policy": "Do not derive these values at test runtime. Change a value only with an intentional accounting or canonical-output change and review the exact/N-1 delta.",
  "configurations": {
    "binding_interactive": "Binding core with its default Unicode ASCII options and the interactive resource profile.",
    "wasm_interactive": "WASM operation forwarding the binding-core default Unicode ASCII options and interactive profile.",
    "uniffi_interactive": "UniFFI operation forwarding the binding-core default Unicode ASCII options and interactive profile.",
    "cli_trusted_native": "CLI --format ascii with the trusted-native resource profile."
  },
  "cases": [
    {
      "id": "max_ascii_grid_cells",
      "phase": "ascii_layout",
      "source": "flowchart TD\nA[Hello] --> B[World]",
      "expected": {
        "binding_interactive": 135,
        "wasm_interactive": 135,
        "uniffi_interactive": 135,
        "cli_trusted_native": 135
      }
    },
    {
      "id": "max_ascii_layout_work_units",
      "phase": "ascii_layout_work",
      "source": "flowchart TD\nA[Hello] --> B[World]",
      "expected": {
        "binding_interactive": 2905,
        "wasm_interactive": 2905,
        "uniffi_interactive": 2905,
        "cli_trusted_native": 2868
      }
    },
    {
      "id": "max_ascii_document_cells",
      "phase": "ascii_document",
      "source": "gitGraph\n  commit id: \"A\"",
      "expected": {
        "binding_interactive": 161,
        "wasm_interactive": 161,
        "uniffi_interactive": 161,
        "cli_trusted_native": 161
      }
    },
    {
      "id": "max_ascii_output_bytes",
      "phase": "ascii_output",
      "source": "flowchart TD\nA[Hello] --> B[World]",
      "expected": {
        "binding_interactive": 256,
        "wasm_interactive": 256,
        "uniffi_interactive": 256,
        "cli_trusted_native": 150
      }
    },
    {
      "id": "max_ascii_grapheme_bytes",
      "phase": "ascii_grapheme",
      "source": "flowchart TD\nA[👨‍👩‍👧‍👦]",
      "expected": {
        "binding_interactive": 25,
        "wasm_interactive": 25,
        "uniffi_interactive": 25,
        "cli_trusted_native": 25
      }
    },
    {
      "id": "max_ascii_nesting_depth",
      "phase": "ascii_nesting",
      "source": "mindmap\n  Root\n    Child",
      "expected": {
        "binding_interactive": 2,
        "wasm_interactive": 2,
        "uniffi_interactive": 2,
        "cli_trusted_native": 2
      }
    }
  ]
}
