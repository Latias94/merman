{
  "schema_version": 1,
  "descriptor_id": "merman-feature-surface",
  "targets": [
    {
      "id": "native",
      "description": "Native Rust, CLI, and native binding artifacts."
    },
    {
      "id": "web",
      "description": "Browser wasm-bindgen artifacts."
    },
    {
      "id": "typst",
      "description": "Pure-WASM Typst plugin artifacts."
    }
  ],
  "runtime_capabilities": [
    {
      "id": "browser-time",
      "kind": "adapter",
      "description": "Browser-provided date and time adapter.",
      "targets": ["web"]
    },
    {
      "id": "browser-random",
      "kind": "adapter",
      "description": "Browser-provided randomness adapter.",
      "targets": ["web"]
    },
    {
      "id": "browser-timing",
      "kind": "adapter",
      "description": "Browser monotonic timing adapter.",
      "targets": ["web"]
    },
    {
      "id": "typst-transport",
      "kind": "transport",
      "description": "Typst wasm-minimal-protocol transport.",
      "targets": ["typst"]
    }
  ],
  "capabilities": [
    {
      "id": "svg",
      "kind": "output",
      "description": "Render Mermaid input as SVG.",
      "targets": ["native", "web", "typst"],
      "implications": [],
      "absence": {
        "error_id": "missing-capability",
        "contract": "SVG requests return a typed missing-capability error when SVG is not compiled."
      }
    },
    {
      "id": "analysis",
      "kind": "api",
      "description": "Expose diagnostics and semantic analysis APIs.",
      "targets": ["native", "web", "typst"],
      "implications": [],
      "absence": {
        "error_id": "missing-capability",
        "contract": "Analysis requests return a typed missing-capability error when analysis is not compiled."
      }
    },
    {
      "id": "editor",
      "kind": "api",
      "description": "Expose parser-backed editor intelligence APIs.",
      "targets": ["native", "web"],
      "implications": ["analysis"],
      "absence": {
        "error_id": "missing-capability",
        "contract": "Editor requests return a typed missing-capability error when editor support is not compiled."
      }
    },
    {
      "id": "ascii",
      "kind": "output",
      "description": "Render supported Mermaid semantics as terminal text.",
      "targets": ["native", "web"],
      "implications": [],
      "absence": {
        "error_id": "missing-capability",
        "contract": "ASCII requests return a typed missing-capability error when ASCII output is not compiled."
      }
    },
    {
      "id": "png",
      "kind": "output",
      "description": "Export rendered diagrams as PNG.",
      "targets": ["native"],
      "implications": ["svg"],
      "absence": {
        "error_id": "missing-capability",
        "contract": "PNG requests return a typed missing-capability error when PNG is not compiled."
      }
    },
    {
      "id": "jpeg",
      "kind": "output",
      "description": "Export rendered diagrams as JPEG.",
      "targets": ["native"],
      "implications": ["svg"],
      "absence": {
        "error_id": "missing-capability",
        "contract": "JPEG requests return a typed missing-capability error when JPEG is not compiled."
      }
    },
    {
      "id": "pdf",
      "kind": "output",
      "description": "Export rendered diagrams as PDF.",
      "targets": ["native"],
      "implications": ["svg"],
      "absence": {
        "error_id": "missing-capability",
        "contract": "PDF requests return a typed missing-capability error when PDF is not compiled."
      }
    },
    {
      "id": "layout-cytoscape",
      "kind": "engine",
      "description": "Enable Mermaid Cytoscape-backed layout behavior.",
      "targets": ["native", "web", "typst"],
      "implications": ["svg"],
      "absence": {
        "error_id": "missing-capability",
        "contract": "A request requiring Cytoscape layout returns a typed missing-capability error when the engine is absent."
      }
    },
    {
      "id": "layout-elk",
      "kind": "engine",
      "description": "Enable Mermaid ELK-backed layout behavior.",
      "targets": ["native", "web", "typst"],
      "implications": ["svg"],
      "absence": {
        "error_id": "missing-capability",
        "contract": "A request requiring ELK layout returns a typed missing-capability error when the engine is absent."
      }
    },
    {
      "id": "math",
      "kind": "engine",
      "description": "Render Mermaid math labels with the selected math engine.",
      "targets": ["native", "web"],
      "implications": ["svg"],
      "absence": {
        "error_id": "missing-capability",
        "contract": "Math-bearing render requests return a typed missing-capability error when math is absent."
      }
    },
    {
      "id": "system-clock",
      "kind": "adapter",
      "description": "Compile the native system clock adapter.",
      "targets": ["native"],
      "implications": [],
      "absence": {
        "error_id": "missing-capability",
        "contract": "Native clock selection returns a typed missing-capability error when the adapter is absent."
      }
    },
    {
      "id": "system-timezone",
      "kind": "adapter",
      "description": "Compile the native system time-zone adapter.",
      "targets": ["native"],
      "implications": [],
      "absence": {
        "error_id": "missing-capability",
        "contract": "System time-zone selection returns a typed missing-capability error when the adapter is absent."
      }
    },
    {
      "id": "system-random",
      "kind": "adapter",
      "description": "Compile the native system randomness adapter.",
      "targets": ["native"],
      "implications": [],
      "absence": {
        "error_id": "missing-capability",
        "contract": "System randomness selection returns a typed missing-capability error when the adapter is absent."
      }
    },
    {
      "id": "system-timing",
      "kind": "adapter",
      "description": "Compile the native monotonic timing adapter.",
      "targets": ["native"],
      "implications": [],
      "absence": {
        "error_id": "missing-capability",
        "contract": "System timing selection returns a typed missing-capability error when the adapter is absent."
      }
    },
    {
      "id": "network-icons",
      "kind": "tool",
      "description": "Compile CLI network icon loading commands.",
      "targets": ["native"],
      "implications": [],
      "absence": {
        "error_id": "command-not-compiled",
        "contract": "Network icon commands are absent from the compiled CLI when this leaf is disabled."
      }
    },
    {
      "id": "parallel-markdown",
      "kind": "tool",
      "description": "Compile parallel CLI Markdown batch processing.",
      "targets": ["native"],
      "implications": [],
      "absence": {
        "error_id": "command-not-compiled",
        "contract": "Parallel Markdown execution is absent from the compiled CLI when this leaf is disabled."
      }
    },
    {
      "id": "shell-completions",
      "kind": "tool",
      "description": "Compile CLI shell completion generation.",
      "targets": ["native"],
      "implications": [],
      "absence": {
        "error_id": "command-not-compiled",
        "contract": "Shell completion commands are absent from the compiled CLI when this leaf is disabled."
      }
    }
  ],
  "outputs": [
    {
      "id": "svg",
      "capability": "svg",
      "description": "Scalable Vector Graphics output.",
      "media_type": "image/svg+xml",
      "targets": ["native", "web", "typst"]
    },
    {
      "id": "ascii",
      "capability": "ascii",
      "description": "Plain terminal text output.",
      "media_type": "text/plain; charset=utf-8",
      "targets": ["native", "web"]
    },
    {
      "id": "png",
      "capability": "png",
      "description": "Portable Network Graphics output.",
      "media_type": "image/png",
      "targets": ["native"]
    },
    {
      "id": "jpeg",
      "capability": "jpeg",
      "description": "JPEG image output.",
      "media_type": "image/jpeg",
      "targets": ["native"]
    },
    {
      "id": "pdf",
      "capability": "pdf",
      "description": "Portable Document Format output.",
      "media_type": "application/pdf",
      "targets": ["native"]
    }
  ],
  "presets": [
    {
      "id": "preset-svg-basic",
      "description": "SVG workflow without optional layout or math engines.",
      "targets": ["native", "web", "typst"],
      "includes": ["svg"],
      "expected_runtime_capabilities": ["svg"]
    },
    {
      "id": "preset-native-svg",
      "description": "Default native Rust SVG workflow.",
      "targets": ["native"],
      "includes": ["svg", "layout-cytoscape", "layout-elk", "math", "system-clock", "system-timezone", "system-random", "system-timing"],
      "expected_runtime_capabilities": ["svg", "layout-cytoscape", "layout-elk", "math", "system-clock", "system-timezone", "system-random", "system-timing"]
    },
    {
      "id": "preset-static-svg",
      "description": "Static-site SVG workflow with no system adapters.",
      "targets": ["native"],
      "includes": ["svg", "layout-cytoscape", "layout-elk", "math"],
      "expected_runtime_capabilities": ["svg", "layout-cytoscape", "layout-elk", "math"]
    },
    {
      "id": "preset-editor",
      "description": "Editor library and LSP library workflow.",
      "targets": ["native"],
      "includes": ["analysis", "editor"],
      "expected_runtime_capabilities": ["analysis", "editor"]
    },
    {
      "id": "preset-ci-lint",
      "description": "Lean CLI lint workflow.",
      "targets": ["native"],
      "includes": ["analysis"],
      "expected_runtime_capabilities": ["analysis"]
    },
    {
      "id": "preset-native-sdk",
      "description": "Native SDK and binding artifact workflow.",
      "targets": ["native"],
      "includes": ["svg", "analysis", "ascii", "png", "jpeg", "pdf", "layout-cytoscape", "layout-elk", "math", "system-clock", "system-timezone", "system-random", "system-timing"],
      "expected_runtime_capabilities": ["svg", "analysis", "ascii", "png", "jpeg", "pdf", "layout-cytoscape", "layout-elk", "math", "system-clock", "system-timezone", "system-random", "system-timing"]
    },
    {
      "id": "preset-mmdc",
      "description": "Default complete CLI workflow.",
      "targets": ["native"],
      "includes": ["preset-native-sdk", "network-icons", "parallel-markdown", "shell-completions"],
      "expected_runtime_capabilities": ["svg", "analysis", "ascii", "png", "jpeg", "pdf", "layout-cytoscape", "layout-elk", "math", "system-clock", "system-timezone", "system-random", "system-timing", "network-icons", "parallel-markdown", "shell-completions"]
    },
    {
      "id": "preset-all",
      "description": "Exhaustive non-tool Rust build and test workflow.",
      "targets": ["native"],
      "includes": ["svg", "analysis", "editor", "ascii", "png", "jpeg", "pdf", "layout-cytoscape", "layout-elk", "math", "system-clock", "system-timezone", "system-random", "system-timing"],
      "expected_runtime_capabilities": ["svg", "analysis", "editor", "ascii", "png", "jpeg", "pdf", "layout-cytoscape", "layout-elk", "math", "system-clock", "system-timezone", "system-random", "system-timing"]
    },
    {
      "id": "preset-web-analysis",
      "description": "Browser analysis artifact.",
      "targets": ["web"],
      "includes": ["analysis"],
      "expected_runtime_capabilities": ["analysis"]
    },
    {
      "id": "preset-web-render",
      "description": "Browser SVG render artifact.",
      "targets": ["web"],
      "includes": ["svg", "layout-cytoscape", "layout-elk", "math"],
      "expected_runtime_capabilities": ["svg", "layout-cytoscape", "layout-elk", "math", "browser-time", "browser-random", "browser-timing"]
    },
    {
      "id": "preset-web-editor",
      "description": "Browser editor intelligence artifact.",
      "targets": ["web"],
      "includes": ["analysis", "editor"],
      "expected_runtime_capabilities": ["analysis", "editor"]
    },
    {
      "id": "preset-web-ascii",
      "description": "Browser ASCII artifact.",
      "targets": ["web"],
      "includes": ["ascii"],
      "expected_runtime_capabilities": ["ascii"]
    },
    {
      "id": "preset-web-full",
      "description": "Fused browser artifact containing all retained Web workflows.",
      "targets": ["web"],
      "includes": ["preset-web-analysis", "preset-web-render", "preset-web-editor", "preset-web-ascii"],
      "expected_runtime_capabilities": ["svg", "analysis", "editor", "ascii", "layout-cytoscape", "layout-elk", "math", "browser-time", "browser-random", "browser-timing"]
    }
  ]
}
