{
  "diagramType": "railroadPeg",
  "model": {
    "type": "railroadPeg",
    "title": "Predicates on grouped suffixes",
    "accTitle": "PEG predicate precedence",
    "accDescr": "Predicates wrap suffixed groups while later rules preserve references.",
    "rules": [
      {
        "name": "Token",
        "definition": {
          "type": "sequence",
          "elements": [
            {
              "type": "special",
              "text": "&(...)"
            },
            {
              "type": "special",
              "text": "!(...)"
            },
            {
              "type": "repetition",
              "element": {
                "type": "choice",
                "alternatives": [
                  {
                    "type": "terminal",
                    "value": "x"
                  },
                  {
                    "type": "terminal",
                    "value": "y"
                  }
                ]
              },
              "min": 0,
              "max": null
            },
            {
              "type": "special",
              "text": "."
            }
          ]
        }
      },
      {
        "name": "End",
        "definition": {
          "type": "terminal",
          "value": "!"
        }
      }
    ]
  }
}
