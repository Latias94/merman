  "effects": [
    {
      "id": "path-fill-stroke",
      "disposition": "vector",
      "family": "flowchart",
      "source": "flowchart TD\nA[Start] --> B[End]\n",
      "assertion": "path_fill_stroke",
      "expected_effects": ["expanded_marker", "host_text", "path"],
      "evidence": "DrawingCommand::DrawPath with resolved fill and stroke"
    },
    {
      "id": "host-text",
      "disposition": "vector",
      "family": "info",
      "source": "info",
      "assertion": "host_text",
      "expected_effects": ["host_text"],
      "evidence": "DrawingCommand::DrawText with TextObligation::HostText"
    },
    {
      "id": "linear-gradient",
      "disposition": "vector",
      "family": "sankey",
      "source": "sankey\nSource,Target,10\n",
      "assertion": "linear_gradient",
      "expected_effects": ["blend_mode", "host_text", "linear_gradient", "opacity", "path"],
      "evidence": "DrawingResource::LinearGradient referenced by a link paint"
    },
    {
      "id": "clip-path",
      "disposition": "vector",
      "family": "treemap",
      "source": "treemap-beta\n\"Root\"\n  \"Child\": 1\n",
      "assertion": "clip_path",
      "expected_effects": ["clip_path", "host_text", "path", "transform"],
      "evidence": "DrawingCommand::ClipPath scopes a section paint"
    },
    {
      "id": "semantic-link",
      "disposition": "vector",
      "family": "flowchart",
      "source": "flowchart TD\nA[Start] --> B[End]\nclick A \"https://example.invalid/start\"\n",
      "assertion": "semantic_link",
      "expected_effects": ["expanded_marker", "host_text", "path", "semantic_link"],
      "evidence": "SemanticAnnotation.link carries a sanitized navigation URI"
    },
    {
      "id": "opacity",
      "disposition": "vector",
      "family": "cynefin",
      "source": "cynefin-beta\n  complex\n    \"Observe\"\n  complicated\n    \"Analyze\"\n  complex --> complicated : \"move\"\n",
      "assertion": "opacity",
      "expected_effects": ["host_text", "opacity", "path", "transform"],
      "evidence": "SetOpacity retains translucent domain backgrounds"
    },
    {
      "id": "blend-mode",
      "disposition": "vector",
      "family": "sankey",
      "source": "sankey-beta\nA,B,10\n",
      "assertion": "blend_mode",
      "expected_effects": ["blend_mode", "host_text", "linear_gradient", "opacity", "path"],
      "evidence": "SetBlendMode retains the link compositing mode"
    },
    {
      "id": "transform",
      "disposition": "vector",
      "family": "quadrantChart",
      "source": "quadrantChart\n  x-axis Low --> High\n  y-axis Bottom --> Top\n  quadrant-1 Invest\n  quadrant-2 Explore\n  quadrant-3 Retire\n  quadrant-4 Maintain\n  Feature: [0.7, 0.8]\n",
      "assertion": "transform",
      "expected_effects": ["host_text", "path", "transform"],
      "evidence": "ConcatTransform retains the chart's translated drawing space"
    },
    {
      "id": "wardley-expanded-marker",
      "disposition": "vector",
      "family": "wardley",
      "source": "wardley-beta\ncomponent A [0.8, 0.2]\ncomponent B [0.4, 0.8]\nA -> B\nevolve A 0.7\n",
      "assertion": "expanded_marker",
      "expected_effects": ["expanded_marker", "host_text", "opacity", "path", "transform"],
      "evidence": "Wardley link and evolution markers are ordinary path resources"
    },
