{
  "grammars": [
    {
      "name": "mermaid",
      "camelcase": "Mermaid",
      "scope": "source.mermaid",
      "path": ".",
      "file-types": [
        "mmd",
        "mermaid"
      ],
      "injection-regex": "^(mermaid|mmd)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tolerant Tree-sitter grammar and editor queries for Mermaid",
    "authors": [
      {
        "name": "Merman contributors"
      }
    ],
    "links": {
      "repository": "https://github.com/Latias94/merman"
    }
  },
  "bindings": {
    "c": false,
    "node": false,
    "rust": false,
    "python": false,
    "swift": false,
    "go": false
  }
}
