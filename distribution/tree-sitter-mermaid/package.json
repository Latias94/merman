{
  "name": "tree-sitter-mermaid",
  "version": "0.1.0",
  "description": "Tolerant Tree-sitter grammar and editor queries for Mermaid",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "main": "./bindings/node/index.js",
  "types": "./bindings/node/index.d.ts",
  "files": [
    "bindings",
    "binding.gyp",
    "grammar.js",
    "grammar",
    "LICENSE",
    "metadata",
    "queries",
    "scripts/*.js",
    "scripts/*.py",
    "scripts/header-oracle/package.json",
    "scripts/header-oracle/package-lock.json",
    "README.md",
    "src",
    "THIRD_PARTY_LICENSES",
    "THIRD_PARTY_NOTICES.md",
    "tree-sitter.json",
    "wasm"
  ],
  "scripts": {
    "build:node": "node-gyp rebuild",
    "generate": "node scripts/run_python.js scripts/generate.py --write",
    "generate:header-oracle": "node scripts/header_oracle.js --node-modules scripts/header-oracle/node_modules --write",
    "generate:header-evidence": "node scripts/header_receipt.js --write",
    "generate:check": "npm run check:generated",
    "check:header-oracle": "node scripts/header_oracle.js --node-modules scripts/header-oracle/node_modules",
    "check:generated": "node scripts/run_python.js scripts/generate.py",
    "check:header-evidence": "node scripts/header_receipt.js",
    "check:metadata": "cargo run --locked -p xtask -- verify-tree-sitter-mermaid",
    "metrics:check": "npm run test:mechanics",
    "build:wasm": "node scripts/run_python.js scripts/generate.py",
    "test:corpus": "tree-sitter test --overview-only",
    "test:corpus:wasm": "node scripts/test_wasm_corpus.js",
    "test:edits": "tree-sitter fuzz --iterations 5 --edits 5",
    "test:generation-script": "node scripts/run_python.js -m unittest scripts.test_generate scripts.test_c_smoke",
    "test:incremental": "cargo nextest run --locked -p tree-sitter-mermaid --test incremental --no-fail-fast",
    "test:adversarial": "cargo nextest run --locked -p tree-sitter-mermaid --test adversarial --no-fail-fast",
    "test:mechanics": "node scripts/mechanics_gate.js",
    "test:queries": "node scripts/query_golden.js && node test/queries/neovim/verify.js && node test/queries/helix/verify.js && node test/queries/zed/verify.js",
    "test:downstream": "node --test test/downstream/downstream_smoke.test.js && node scripts/downstream_smoke.js",
    "test:node": "node --test bindings/query-profiles_test.js bindings/node/binding_test.js",
    "test:c": "node scripts/run_python.js scripts/c_smoke.py",
    "test:wasm": "node --test bindings/node/wasm_test.js",
    "test:package-smoke": "node scripts/run_python.js scripts/package_smoke.py",
    "fuzz:regression": "node scripts/fuzz_regression.js",
    "test": "npm run check:header-evidence && npm run check:metadata && npm run test:generation-script && npm run test:corpus && npm run test:corpus:wasm && npm run test:edits && npm run test:queries && npm run test:node && npm run test:c && npm run test:wasm && npm run test:mechanics"
  },
  "dependencies": {
    "node-addon-api": "8.9.2",
    "node-gyp-build": "4.8.4"
  },
  "devDependencies": {
    "node-gyp": "12.1.0",
    "tree-sitter": "0.25.1",
    "tree-sitter-cli": "0.26.12",
    "web-tree-sitter": "0.26.12"
  },
  "tree-sitter": [
    {
      "scope": "source.mermaid",
      "file-types": [
        "mmd",
        "mermaid"
      ],
      "injection-regex": "^(mermaid|mmd)$"
    }
  ]
}
