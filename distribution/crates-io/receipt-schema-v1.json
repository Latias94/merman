{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Latias94/merman/blob/main/distribution/crates-io/receipt-schema-v1.json",
  "title": "Merman crates.io topological batch receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema",
    "channel",
    "kind",
    "state",
    "source",
    "toolchain",
    "plan_sha256",
    "batch_index",
    "packages"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "schema": { "const": "distribution/crates-io/receipt-schema-v1.json" },
    "channel": { "const": "crates.io" },
    "kind": { "const": "topological-batch" },
    "state": {
      "enum": [
        "prepared",
        "complete",
        "preflight_failed",
        "pending_recovery",
        "mismatch"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitObject" },
        "tree": { "$ref": "#/$defs/gitObject" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cargo", "rustc"],
      "properties": {
        "cargo": { "type": "string", "minLength": 1 },
        "rustc": { "type": "string", "minLength": 1 }
      }
    },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "batch_index": { "type": "integer", "minimum": 0 },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "manifest_path",
        "manifest_sha256",
        "internal_dependencies",
        "artifact",
        "registry"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "manifest_path": { "type": "string", "minLength": 1 },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "internal_dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "size"],
          "properties": {
            "sha256": { "$ref": "#/$defs/sha256" },
            "size": { "type": "integer", "minimum": 1 }
          }
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "observed_checksum", "publish_returncode"],
          "properties": {
            "status": { "type": "string", "minLength": 1 },
            "observed_checksum": {
              "anyOf": [
                { "$ref": "#/$defs/sha256" },
                { "type": "null" }
              ]
            },
            "publish_returncode": {
              "type": ["integer", "null"]
            },
            "error": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
