{
  "version": "${VERSION}",
  "description": "Headless Mermaid-compatible diagram renderer for SVG, PNG, JPEG, PDF, ASCII, and Unicode output",
  "homepage": "${REPOSITORY_URL}",
  "license": "MIT|Apache-2.0",
  "architecture": {
    "64bit": {
      "url": "${ARCHIVE_URL}",
      "hash": "${SHA256}"
    }
  },
  "bin": "merman-cli.exe",
  "checkver": {
    "url": "${RELEASES_API_URL}",
    "regex": "\"tag_name\":\\s*\"v([0-9]+\\.[0-9]+\\.[0-9]+)\""
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "${AUTOUPDATE_URL}"
      }
    }
  }
}
