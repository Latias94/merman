{
  "schema_version": 1,
  "kind": "design",
  "design": {
    "tokens": {
      "paper": { "type": "paint", "label": "Pure white paper", "group": "Document hierarchy", "description": "Opaque exported canvas, ordinary bodies, and relationship-label backings share a clean white ground.", "value": "#FFFFFF" },
      "ink": { "type": "paint", "label": "Primary document ink", "group": "Document hierarchy", "description": "Primary lettering stays near black on every authored light surface. Diagram structure and labels carry meaning independently of hue.", "value": "#161616" },
      "secondary-ink": { "type": "paint", "label": "Secondary document ink", "group": "Document hierarchy", "value": "#555555" },
      "outline": { "type": "paint", "label": "Body contours", "group": "Document hierarchy", "description": "Dark body boundaries and table dividers remain distinct from pale grouping panels.", "value": "#303030" },
      "connector": { "type": "paint", "label": "Relationships", "group": "Document hierarchy", "description": "Connectors and their visible markers share a neutral, independently editable ink.", "value": "#404040" },
      "rule": { "type": "paint", "label": "Supporting rules", "group": "Document hierarchy", "description": "Lifelines, panel outlines, chart axes, and tree connectors stay visible without competing with names.", "value": "#737373" },
      "panel": { "type": "paint", "label": "Structural panel", "group": "Document hierarchy", "description": "Namespace panels, composite headers, activations, alternate entity rows, and existing tree highlights share this neutral gray.", "value": "#EFEFEF" },
      "annotation": { "type": "paint", "label": "Annotation ground", "group": "Document hierarchy", "value": "#F7F7F7" },
      "body-font": { "type": "font-stack", "label": "Document text", "group": "Typography", "value": ["Arial", "Liberation Sans", "sans-serif"] },
      "code-font": { "type": "font-stack", "label": "Measured technical text", "group": "Typography", "description": "Class names and signatures use the same measured monospace stack. Entity attributes and tree paths use it too; font files are not embedded.", "value": ["Consolas", "Liberation Mono", "monospace"] },
      "series": { "type": "palette", "label": "Neutral data marks", "group": "Palettes", "description": "Ordered neutral series preserve the sample's labels and legend associations. Grayscale alone does not distinguish an arbitrary number of overlapping series.", "value": ["#404040", "#737373", "#999999", "#B8B8B8", "#565656", "#878787"] },
      "category-surfaces": { "type": "palette", "label": "Labeled neutral categories", "group": "Palettes", "description": "Stepped light grays keep near-black Pie labels and Mindmap branch labels readable. Sectors retain outlines and textual legends; these fills are not a color-vision or print qualification. The Mindmap root has a separate git0 compatibility scalar.", "value": ["#9F9F9F", "#BCBCBC", "#D9D9D9", "#F6F6F6", "#ADADAD", "#E4E4E4"] }
    },
    "canvas": { "base": { "ref": "paper" } },
    "typography": {
      "default": { "font_stack": { "ref": "body-font" } },
      "families": {
        "flowchart": { "font_size_px": 15 },
        "sequence": { "font_size_px": 14 },
        "class": { "font_stack": { "ref": "code-font" }, "font_size_px": 14 },
        "state": { "font_size_px": 15 },
        "er": { "font_stack": { "ref": "code-font" }, "font_size_px": 14 },
        "mindmap": { "font_stack": { "ref": "body-font" } },
        "requirement": { "font_size_px": 14 },
        "treeView": { "font_stack": { "ref": "code-font" }, "font_size_px": 14 }
      }
    },
    "styles": {
      "text": { "fill": { "ref": "ink" } }
    },
    "rules": [
      { "family": "flowchart", "target": "node", "style": { "fill": { "ref": "paper" }, "stroke": { "paint": { "ref": "outline" }, "width": 1.25 }, "effect": null } },
      { "family": "flowchart", "target": "node-label", "style": { "fill": { "ref": "ink" }, "typography": { "font_weight": 600 } } },
      { "family": "flowchart", "target": "edge", "style": { "stroke": { "paint": { "ref": "connector" }, "width": 1.25 } } },
      { "family": "flowchart", "target": "edge-label", "style": { "typography": { "font_size_px": 12 } } },
      { "family": "flowchart", "target": "edge-label-background", "style": { "fill": { "ref": "paper" } } },
      { "family": "flowchart", "target": "cluster", "style": { "fill": { "ref": "annotation" }, "stroke": { "paint": { "ref": "rule" }, "width": 1 } } },
      { "family": "flowchart", "target": "cluster-label", "style": { "fill": { "ref": "secondary-ink" } } },
      { "family": "sequence", "target": "actor", "style": { "fill": { "ref": "paper" }, "stroke": { "paint": { "ref": "outline" }, "width": 1.25 }, "effect": null } },
      { "family": "sequence", "target": "actor-label", "style": { "fill": { "ref": "ink" }, "typography": { "font_size_px": 15, "font_weight": 600 } } },
      { "family": "sequence", "target": "lifeline", "style": { "stroke": { "paint": { "ref": "rule" }, "width": 1 } } },
      { "family": "sequence", "target": "message", "style": { "stroke": { "paint": { "ref": "connector" }, "width": 1.25 } } },
      { "family": "sequence", "target": "message-label", "style": { "fill": { "ref": "ink" }, "typography": { "font_size_px": 14 } } },
      { "family": "sequence", "target": "note", "style": { "fill": { "ref": "annotation" }, "stroke": { "paint": { "ref": "rule" }, "width": 1 }, "effect": null } },
      { "family": "sequence", "target": "note-label", "style": { "fill": { "ref": "ink" }, "typography": { "font_size_px": 14 } } },
      { "family": "sequence", "target": "activation", "style": { "fill": { "ref": "panel" }, "stroke": { "paint": { "ref": "outline" }, "width": 1 } } },
      { "family": "sequence", "target": "loop", "style": { "stroke": { "paint": { "ref": "rule" }, "width": 1 } } },
      { "family": "sequence", "target": "loop-label-background", "style": { "fill": { "ref": "panel" }, "stroke": { "paint": { "ref": "rule" }, "width": 1 } } },
      { "family": "sequence", "target": "loop-label", "style": { "fill": { "ref": "secondary-ink" }, "typography": { "font_size_px": 13 } } },
      { "family": "sequence", "target": "sequence-number", "style": { "fill": { "ref": "paper" } } },
      { "family": "class", "target": "node", "style": { "fill": { "ref": "paper" }, "stroke": { "paint": { "ref": "outline" } } } },
      { "family": "class", "target": "node-label", "style": { "fill": { "ref": "ink" } } },
      { "family": "class", "target": "edge", "style": { "stroke": { "paint": { "ref": "connector" }, "width": 1.25 } } },
      { "family": "class", "target": "edge-label-background", "style": { "fill": { "ref": "paper" } } },
      { "family": "class", "target": "cluster", "style": { "fill": { "ref": "annotation" }, "stroke": { "paint": { "ref": "rule" } } } },
      { "family": "xychart", "target": "axis", "style": { "fill": { "ref": "secondary-ink" }, "stroke": { "paint": { "ref": "rule" } } } },
      { "family": "xychart", "target": "axis-tick", "style": { "stroke": { "paint": { "ref": "rule" } } } },
      { "family": "xychart", "target": "title", "style": { "fill": { "ref": "ink" }, "typography": { "font_size_px": 20, "font_weight": 600 } } },
      { "family": "xychart", "target": "axis-title", "style": { "fill": { "ref": "secondary-ink" }, "typography": { "font_size_px": 13, "font_weight": 600 } } },
      { "family": "xychart", "target": "axis-label", "style": { "fill": { "ref": "secondary-ink" }, "typography": { "font_size_px": 12 } } },
      { "family": "xychart", "target": "legend", "style": { "fill": { "ref": "ink" }, "typography": { "font_size_px": 13 } } },
      { "family": "xychart", "target": "chart-series", "variant": "bar", "style": { "stroke": { "width": 1 } } },
      { "family": "xychart", "target": "chart-series", "variant": "line", "style": { "stroke": { "width": 2.5 } } },
      { "family": "pie", "target": "pie-slice", "style": { "stroke": { "paint": { "ref": "outline" } } } },
      { "family": "pie", "target": "text", "style": { "fill": { "ref": "ink" }, "typography": { "font_size_px": 15, "font_weight": 600 } } },
      { "family": "pie", "target": "title", "style": { "fill": { "ref": "ink" }, "typography": { "font_size_px": 20, "font_weight": 600 } } },
      { "family": "pie", "target": "legend", "style": { "fill": { "ref": "ink" }, "typography": { "font_size_px": 13 } } },
      { "family": "state", "target": "text", "style": { "fill": { "ref": "ink" } } },
      { "family": "state", "target": "state", "style": { "fill": { "ref": "paper" }, "stroke": { "paint": { "ref": "outline" }, "width": 1.25 } } },
      { "family": "state", "target": "state-label", "style": { "fill": { "ref": "ink" }, "typography": { "font_weight": 600 } } },
      { "family": "state", "target": "composite", "style": { "fill": { "ref": "paper" }, "stroke": { "paint": { "ref": "rule" }, "width": 1 } } },
      { "family": "state", "target": "composite-header", "style": { "fill": { "ref": "panel" }, "stroke": { "paint": { "ref": "rule" }, "width": 1 } } },
      { "family": "state", "target": "composite-label", "style": { "fill": { "ref": "ink" }, "typography": { "font_weight": 600 } } },
      { "family": "state", "target": "transition", "style": { "stroke": { "paint": { "ref": "connector" }, "width": 1.25 } } },
      { "family": "state", "target": "transition-marker", "style": { "fill": { "ref": "connector" }, "stroke": { "paint": { "ref": "connector" } } } },
      { "family": "state", "target": "transition-label", "style": { "fill": { "ref": "secondary-ink" }, "typography": { "font_size_px": 13 } } },
      { "family": "state", "target": "transition-label-background", "style": { "fill": { "ref": "paper" } } },
      { "family": "state", "target": "special-state", "variant": "start", "style": { "fill": { "ref": "connector" }, "stroke": { "paint": { "ref": "connector" } } } },
      { "family": "state", "target": "special-state", "variant": "end", "style": { "fill": { "ref": "paper" }, "stroke": { "paint": { "ref": "connector" } } } },
      { "family": "state", "target": "special-state-inner", "variant": "end", "style": { "fill": { "ref": "connector" }, "stroke": { "paint": { "ref": "connector" } } } },
      { "family": "state", "target": "special-state", "variant": "special", "style": { "fill": { "ref": "panel" }, "stroke": { "paint": { "ref": "outline" } } } },
      { "family": "state", "target": "note", "style": { "fill": { "ref": "annotation" }, "stroke": { "paint": { "ref": "rule" }, "width": 1 } } },
      { "family": "state", "target": "note-label", "style": { "fill": { "ref": "ink" }, "typography": { "font_size_px": 14 } } },
      { "family": "er", "target": "entity", "style": { "fill": { "ref": "panel" }, "stroke": { "paint": { "ref": "outline" } } } },
      { "family": "er", "target": "table", "variant": "odd", "style": { "fill": { "ref": "paper" } } },
      { "family": "er", "target": "table", "variant": "even", "style": { "fill": { "ref": "panel" } } },
      { "family": "er", "target": "relation", "style": { "stroke": { "paint": { "ref": "connector" } } } },
      { "family": "er", "target": "text", "style": { "fill": { "ref": "ink" } } },
      { "family": "er", "target": "title", "style": { "fill": { "ref": "ink" } } },
      { "family": "mindmap", "target": "text", "style": { "fill": { "ref": "ink" } } },
      { "family": "mindmap", "target": "node-label", "style": { "fill": { "ref": "ink" } } },
      { "family": "mindmap", "target": "edge", "style": { "stroke": { "paint": { "ref": "connector" } } } },
      { "family": "requirement", "target": "requirement", "style": { "fill": { "ref": "paper" }, "stroke": { "paint": { "ref": "outline" } } } },
      { "family": "requirement", "target": "relation", "style": { "stroke": { "paint": { "ref": "connector" } } } },
      { "family": "requirement", "target": "text", "style": { "fill": { "ref": "ink" } } },
      { "family": "treeView", "target": "node", "style": { "fill": { "ref": "panel" }, "stroke": { "paint": { "ref": "outline" } } } },
      { "family": "treeView", "target": "node-label", "style": { "fill": { "ref": "ink" } } },
      { "family": "treeView", "target": "edge", "style": { "stroke": { "paint": { "ref": "rule" }, "width": 1 } } },
      { "family": "treeView", "target": "marker", "style": { "fill": { "ref": "connector" } } }
    ],
    "palettes": {
      "chart-series": { "ref": "series" },
      "pie-slice": { "ref": "category-surfaces" },
      "node": { "ref": "category-surfaces" }
    },
    "mermaid": { "theme": "neutral", "variables": { "git0": "#EFEFEF", "erEdgeLabelBackground": "#FFFFFF", "dropShadow": "none", "useGradient": false } }
  }
}
