      {"family": "state", "target": "state-label", "style": {"fill": {"kind": "solid", "color": {"ref": "ink"}}, "typography": {"font_weight": 500}}},
      {"family": "state", "target": "composite", "style": {"fill": {"kind": "solid", "color": {"ref": "recess"}}, "stroke": {"paint": {"kind": "solid", "color": {"ref": "outline"}}, "width": 0.75}}},
      {"family": "state", "target": "composite-header", "style": {"fill": {"kind": "solid", "color": {"ref": "class-surface"}}, "stroke": {"paint": {"kind": "solid", "color": {"ref": "outline"}}, "width": 0.75}}},
      {"family": "state", "target": "composite-label", "style": {"fill": {"kind": "solid", "color": {"ref": "violet"}}, "typography": {"font_weight": 600}}},
