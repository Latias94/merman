      {"family": "state", "target": "special-state", "variant": "end", "style": {"fill": {"kind": "solid", "color": {"ref": "night"}}, "stroke": {"paint": {"kind": "solid", "color": {"ref": "mint"}}}}},
      {"family": "state", "target": "special-state-inner", "variant": "end", "style": {"fill": {"kind": "solid", "color": {"ref": "mint"}}, "stroke": {"paint": {"kind": "solid", "color": {"ref": "mint"}}}}},
