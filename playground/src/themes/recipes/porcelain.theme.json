      "title-font": { "type": "font-stack", "label": "Report serif", "group": "Typography", "description": "XY and Pie share a family font stack, so their clean data labels inherit the same serif as their titles.", "value": ["Georgia", "Liberation Serif", "serif"] },
      "code-font": { "type": "font-stack", "label": "Class signatures", "group": "Typography", "description": "The whole Class scene uses this measured stack, including names and signatures.", "value": ["Consolas", "Liberation Mono", "monospace"] },
      "series": { "type": "palette", "label": "Ceramic pigments", "group": "Palettes", "description": "Cobalt, terracotta, mineral green, ochre, violet, and moss retain a stable category order.", "value": [{ "ref": "cobalt" }, { "ref": "terracotta" }, { "ref": "mineral" }, "#8B733F", "#77638F", "#636E57"] },
      "pie-series": { "type": "palette", "label": "Glazed category tints", "group": "Palettes", "description": "Pale counterparts in the pigment order serve Pie sectors and Mindmap branches with dark shared ink. The root uses a separate git0 compatibility value; editing this palette does not update that scalar.", "value": ["#D0DEEF", "#E9C7B6", "#C7DED5", "#E8DDB9", "#DDD3E8", "#D8DEC7"] },
      "glaze-sheen": {
        "type": "effect",
        "label": "Fine reflected glaze edge",
        "group": "Effects",
        "description": "A short white upper edge and faint cool lower contact edge on supported Flowchart bodies and Sequence actors. This is an exterior vector highlight, not an inset reflection or body gradient.",
        "value": {
          "kind": "shadow-stack",
          "composition": "independent",
          "color_space": "srgb",
          "shadows": [
            { "offset_x": 0, "offset_y": 1.6, "std_deviation": 0.6, "color": { "ref": "cobalt" }, "opacity": 0.12 },
            { "offset_x": 0, "offset_y": -1, "std_deviation": 0, "color": { "ref": "specular" }, "opacity": 0.95 }
          ]
        }
      }
