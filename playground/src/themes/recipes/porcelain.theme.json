{
  "schema_version": 1,
  "kind": "design",
  "design": {
    "tokens": {
      "canvas": { "type": "color", "label": "Warm ceramic ground", "group": "Ceramic and pigment", "value": "#F4F1E9" },
      "glaze": { "type": "color", "label": "White glaze", "group": "Ceramic and pigment", "description": "Warm white bodies and light entity rows sit inside cobalt contours.", "value": "#FFFEFA" },
      "glaze-band": { "type": "color", "label": "Cool glaze band", "group": "Ceramic and pigment", "description": "A pale mineral wash connects group panels, composite headers, activations, and alternate entity rows.", "value": "#E8EDF1" },
      "ink": { "type": "color", "label": "Cobalt black lettering", "group": "Ceramic and pigment", "description": "Sharp shared text also remains dark on pale categorical surfaces and the engine-owned Mindmap root.", "value": "#27374B" },
      "muted-ink": { "type": "color", "label": "Secondary mineral lettering", "group": "Ceramic and pigment", "value": "#566371" },
      "cobalt": { "type": "color", "label": "Cobalt contour", "group": "Ceramic and pigment", "description": "One pigment binds body contours, connectors, markers, chart titles, the leading series, and the cool contact edge.", "value": "#2E5185" },
      "fine-rule": { "type": "color", "label": "Diluted cobalt ruling", "group": "Ceramic and pigment", "description": "Quieter structural rules distinguish groups, lifelines, and axes from ordinary body contours.", "value": "#8A9CAF" },
      "terracotta": { "type": "color", "label": "Terracotta annotation", "group": "Ceramic and pigment", "description": "Annotation lettering and borders, decision contours, activation borders, and the second series share this restrained accent.", "value": "#A5523B" },
      "note-glaze": { "type": "color", "label": "Terracotta wash", "group": "Ceramic and pigment", "value": "#F6E8DD" },
      "mineral": { "type": "color", "label": "Mineral green pigment", "group": "Ceramic and pigment", "value": "#477C78" },
      "specular": { "type": "color", "label": "Reflected white edge", "group": "Ceramic and pigment", "description": "Used only by the bounded body sheen; text and data marks remain unfiltered.", "value": "#FFFFFF" },
