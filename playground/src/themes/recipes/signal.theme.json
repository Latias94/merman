{
  "schema_version": 1,
  "kind": "design",
  "design": {
    "tokens": {
      "canvas": { "type": "color", "label": "Warm workshop sheet", "group": "Safety graphics", "value": "#F3F0E5" },
      "plate": { "type": "color", "label": "Charcoal equipment plate", "group": "Safety graphics", "description": "The near-black face shared by Flowchart nodes, Sequence nameplates, and Class cards.", "value": "#22251F" },
      "ink": { "type": "color", "label": "Carbon lettering and hardware", "group": "Safety graphics", "description": "Shared by exposed lettering, connectors, chart axes, tape stripes, and the dark lower mounting edge. Text remains unfiltered.", "value": "#22251F" },
      "signal": { "type": "color", "label": "Safety yellow marking", "group": "Safety graphics", "description": "Connects the plate lettering, hard yellow mounting edge, and perimeter warning tape.", "value": "#F7D938" },
      "card-ink": { "type": "color", "label": "Pale yellow technical lettering", "group": "Safety graphics", "description": "A softer, lighter yellow for dense Class signatures on the charcoal cards.", "value": "#FFF2AC" },
      "orange": { "type": "color", "label": "Orange inspection marker", "group": "Safety graphics", "description": "Used for active Sequence intervals. Chart marks use an independent, darker orange ink on workshop paper.", "value": "#E66B2D" },
      "panel": { "type": "color", "label": "Uncoated label panel", "group": "Safety graphics", "value": "#E9E5D6" },
      "muted": { "type": "color", "label": "Secondary carbon lettering", "group": "Safety graphics", "value": "#5E6155" },
      "task-complete": { "type": "color", "label": "Completed inspection", "group": "Gantt status", "description": "A pale equipment-green fill identifies completed work independently of the active safety-yellow bars.", "value": "#C7D2B2" },
      "task-critical": { "type": "color", "label": "Critical inspection", "group": "Gantt status", "description": "Critical bars use this red fill. Combined active/critical and done/critical tasks retain their state fill and use this critical outline.", "value": "#A63C28" },
      "rule": { "type": "color", "label": "Equipment divider", "group": "Safety graphics", "value": "#A19D87" },
      "label-font": { "type": "font-stack", "label": "Condensed industrial label", "group": "Typography", "description": "A compact, heavy sign face keeps ordinary diagrams recognizably industrial without a glow or a comic treatment.", "value": ["Avenir Next Condensed", "Arial Narrow", "Liberation Sans Narrow", "Helvetica Neue", "Arial", "Noto Sans CJK SC", "sans-serif"] },
      "technical-font": { "type": "font-stack", "label": "Equipment specification lettering", "group": "Typography", "value": ["Menlo", "Consolas", "Liberation Mono", "Noto Sans Mono CJK SC", "monospace"] },
      "series": { "type": "palette", "label": "Safety chart markings", "group": "Palettes", "value": ["#7B6900", "#A84718", "#435D6D", "#675328", "#49673C", "#984756"], "description": "Six darker data inks distinguish gold, orange, steel, brass, equipment green, and oxide rose on workshop paper. Safety markings and activation colors remain independent." },
      "pie-ink": { "type": "color", "label": "Pie percentage ink", "group": "Palettes", "description": "Independent opaque percentage lettering is paired with sector colors after the default 0.7 Pie opacity is composited over the exported canvas. Mindmap and other text keep their own ink.", "value": "#080F09" },
      "pie-series": { "type": "palette", "label": "Readable inspection sectors", "group": "Palettes", "description": "Six inspection swatches separate safety yellow, orange, steel blue, brass, equipment green, and oxide rose. Independent Pie ink remains readable through translucent sectors, including over the warning rails.", "value": [{ "ref": "signal" }, "#F2AE72", "#B1C7D5", "#C9B179", "#9EB78A", "#D38F98"] },
      "mounted-plate": {
        "type": "effect",
        "label": "Yellow mounting edge over dark hardware",
        "group": "Plate construction",
        "description": "Two independent, unblurred vertical offsets expose a safety-yellow lower flange over a dark fixing edge on supported Flowchart and Sequence bodies. Labels are never filtered; Class and Pie do not request this effect.",
        "value": {
          "kind": "shadow-stack",
          "composition": "independent",
          "color_space": "srgb",
          "shadows": [
            { "offset_x": 0, "offset_y": 7, "std_deviation": 0, "color": { "ref": "ink" }, "opacity": 1 },
            { "offset_x": 0, "offset_y": 4, "std_deviation": 0, "color": { "ref": "signal" }, "opacity": 1 }
          ]
        }
      },
      "label-edge": {
        "type": "effect",
        "label": "Hard label backing",
        "group": "Plate construction",
        "description": "A small straight lower edge supports Sequence caution notes and chart bars without any blur or diagonal print offset.",
        "value": {
          "kind": "shadow-stack",
          "composition": "independent",
          "color_space": "srgb",
          "shadows": [
            { "offset_x": 0, "offset_y": 2.5, "std_deviation": 0, "color": { "ref": "ink" }, "opacity": 1 }
          ]
        }
      }
    },
    "canvas": {
