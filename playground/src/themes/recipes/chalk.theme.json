{
  "schema_version": 1,
  "kind": "design",
  "design": {
    "tokens": {
      "board": { "type": "color", "label": "Matte slate board", "group": "Board and chalk", "description": "The exported ground, caption backings, and sector separators share this warm green slate.", "value": "#242C2B" },
      "surface": { "type": "color", "label": "Writing surface", "group": "Board and chalk", "description": "Dark ordinary bodies remain close to the board so chalk contours carry their shape.", "value": "#2D3735" },
      "recess": { "type": "color", "label": "Quiet board recess", "group": "Board and chalk", "description": "Group panels and composite bodies sit behind the ordinary writing surfaces.", "value": "#202826" },
      "table-row": { "type": "color", "label": "Alternate slate row", "group": "Board and chalk", "value": "#34413D" },
      "ink": { "type": "color", "label": "Cream chalk lettering", "group": "Board and chalk", "description": "Ordinary labels and chart legends stay cream on dark slate. Opaque pastel branches use dark mark ink; translucent Pie sectors use independent percentage ink.", "value": "#F3EEDC" },
      "muted-ink": { "type": "color", "label": "Secondary chalk lettering", "group": "Board and chalk", "value": "#C8CCBC" },
      "chalk": { "type": "color", "label": "Chalk contour", "group": "Board and chalk", "description": "Crisp cream body contours, connectors, and state markers provide structure without glow or roughened edges.", "value": "#D9DCCB" },
      "quiet-rule": { "type": "color", "label": "Secondary chalk rule", "group": "Board and chalk", "description": "A quieter neutral chalk serves group boundaries, lifelines, axes, and Mindmap connectors.", "value": "#91A59B" },
      "note-surface": { "type": "color", "label": "Lesson annotation ground", "group": "Board and chalk", "value": "#3B4032" },
      "lesson": { "type": "color", "label": "Warm lesson emphasis", "group": "Board and chalk", "description": "Yellow identifies annotations, composite headings, and decisions independently of the category palette.", "value": "#F0D88B" },
      "mark-ink": { "type": "color", "label": "Slate ink on pastel marks", "group": "Board and chalk", "description": "Dark text on opaque pastel Mindmap branches also contrasts with the independent git0 root. Translucent Pie sectors use their separate pie-ink token; recoloring the branch palette does not change the root scalar.", "value": "#26332F" },
      "blue": { "type": "color", "label": "Blue chalk category", "group": "Category chalks", "value": "#97C4E7" },
      "peach": { "type": "color", "label": "Peach chalk category", "group": "Category chalks", "value": "#ECA386" },
      "mint": { "type": "color", "label": "Mint chalk category", "group": "Category chalks", "description": "The third category also marks active Sequence work without recoloring its labels.", "value": "#ACD2B9" },
      "sand": { "type": "color", "label": "Sand chalk category", "group": "Category chalks", "value": "#E3CF83" },
      "lilac": { "type": "color", "label": "Lilac chalk category", "group": "Category chalks", "value": "#BC9AE0" },
      "rose": { "type": "color", "label": "Rose chalk category", "group": "Category chalks", "value": "#DF8FAC" },
      "body-font": { "type": "font-stack", "label": "Clear teaching text", "group": "Typography", "value": ["system-ui", "Segoe UI", "Arial", "Liberation Sans", "sans-serif"] },
      "code-font": { "type": "font-stack", "label": "Class signatures", "group": "Typography", "description": "The whole Class scene uses this measured stack, including names and signatures.", "value": ["Consolas", "Liberation Mono", "monospace"] },
      "series": { "type": "palette", "label": "Pastel chart marks", "group": "Palettes", "description": "Blue, peach, mint, sand, lilac, and rose keep the same category order as the pale surfaces.", "value": [{ "ref": "blue" }, { "ref": "peach" }, { "ref": "mint" }, { "ref": "sand" }, { "ref": "lilac" }, { "ref": "rose" }] },
      "pie-ink": { "type": "color", "label": "Pie percentage ink", "group": "Palettes", "description": "Independent opaque percentage lettering is paired with sector colors after the default 0.7 Pie opacity is composited over the exported canvas. Mindmap and other text keep their own ink.", "value": "#08120C" },
      "pie-series": { "type": "palette", "label": "Pastel category surfaces", "group": "Palettes", "description": "Six chalk pigments separate labeled Pie sectors and Mindmap branches. Pie uses independent near-black percentage ink because its sectors are translucent on the board.", "value": [{ "ref": "blue" }, { "ref": "peach" }, { "ref": "mint" }, { "ref": "sand" }, { "ref": "lilac" }, { "ref": "rose" }] }
