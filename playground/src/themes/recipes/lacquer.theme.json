{
  "schema_version": 1,
  "kind": "design",
  "design": {
    "tokens": {
      "canvas": { "type": "color", "label": "Black lacquer ground", "group": "Lacquer and gold", "value": "#110E12" },
      "surface": { "type": "color", "label": "Oxblood lacquer", "group": "Lacquer and gold", "description": "Shared by ordinary Flowchart nodes, Sequence actor plaques, and Class bodies.", "value": "#3D1824" },
      "recess": { "type": "color", "label": "Recessed black panel", "group": "Lacquer and gold", "value": "#1A131A" },
      "ink": { "type": "color", "label": "Ivory lettering", "group": "Lacquer and gold", "description": "Shared text stays unfiltered, including Flowchart edge labels.", "value": "#F2E9D6" },
      "muted": { "type": "color", "label": "Warm secondary lettering", "group": "Lacquer and gold", "value": "#BEAB93" },
      "gold": { "type": "color", "label": "Pale gold inlay", "group": "Lacquer and gold", "description": "Shared by the asymmetric hard rim, connectors, activation edges, and chart highlights.", "value": "#D8BC82" },
      "outline": { "type": "color", "label": "Antique gold structure", "group": "Lacquer and gold", "value": "#947C57" },
      "wine-reflection": { "type": "color", "label": "Wine gloss reflection", "group": "Lacquer and gold", "description": "A restrained diagonal canvas reflection; this is a vector sheen, not a physical lighting simulation.", "value": "#946272" },
      "note": { "type": "color", "label": "Inset annotation plaque", "group": "Lacquer and gold", "value": "#291B23" },
      "vermilion": { "type": "color", "label": "Lacquer chart mark", "group": "Lacquer and gold", "value": "#A45B69" },
      "active-surface": { "type": "color", "label": "Gold activation interior", "group": "Lacquer and gold", "description": "An independent translucent swatch; edit alongside Pale gold inlay when recoloring.", "value": "#D8BC823D" },
      "body-font": { "type": "font-stack", "label": "Clear supporting text", "group": "Typography", "value": ["Avenir", "Segoe UI", "Arial", "Noto Sans CJK SC", "sans-serif"] },
      "display-font": { "type": "font-stack", "label": "Editorial serif lettering", "group": "Typography", "value": ["Georgia", "Times New Roman", "Noto Serif CJK SC", "serif"] },
      "code-font": { "type": "font-stack", "label": "Class signatures", "group": "Typography", "value": ["Menlo", "Consolas", "Liberation Mono", "Noto Sans Mono CJK SC", "monospace"] },
      "series": { "type": "palette", "label": "Lacquer chart accents", "group": "Palettes", "value": [{ "ref": "vermilion" }, { "ref": "gold" }, "#9CA99C", "#B19CB9", "#A0B5BC", "#C19C71"] },
      "pie-series": { "type": "palette", "label": "Lacquer compartments", "group": "Palettes", "description": "Independent dark swatches retain ivory percentage contrast; pale gold separators distinguish adjacent compartments.", "value": ["#6E2E40", "#3E4442", "#654F31", "#473649", "#2E4A4C", "#48402D"] },
      "gold-rim": {
        "type": "effect",
        "label": "Asymmetric inlaid rim",
        "group": "Effects",
        "description": "A narrow unblurred gold offset to the left and below supported Flowchart bodies and Sequence actor plaques. Labels, Class, and Pie remain unfiltered.",
        "value": {
          "kind": "shadow-stack",
          "composition": "independent",
          "color_space": "srgb",
          "shadows": [
            { "offset_x": 1, "offset_y": 3, "std_deviation": 0.7, "color": { "ref": "canvas" }, "opacity": 0.65 },
            { "offset_x": -2.4, "offset_y": 1.6, "std_deviation": 0, "color": { "ref": "gold" }, "opacity": 0.85 }
          ]
        }
      },
      "chart-rim": {
        "type": "effect",
        "label": "Fine chart inlay",
        "group": "Effects",
        "description": "A subpixel-width gold registration edge on XY bars; chart lines and all text remain unfiltered.",
        "value": {
          "kind": "shadow-stack",
          "composition": "independent",
          "color_space": "srgb",
          "shadows": [
            { "offset_x": -0.8, "offset_y": 0.8, "std_deviation": 0, "color": { "ref": "gold" }, "opacity": 0.8 }
          ]
        }
      }
    },
    "canvas": {
      "base": { "kind": "solid", "color": { "ref": "canvas" } },
      "layers": [
        {
          "paint": {
            "kind": "linear-gradient",
            "angle_degrees": 135,
            "stops": [
              { "offset": 0, "color": { "ref": "wine-reflection" }, "opacity": 0.16 },
              { "offset": 0.19, "color": { "ref": "wine-reflection" }, "opacity": 0.16 },
              { "offset": 0.22, "color": { "ref": "wine-reflection" }, "opacity": 0.035 },
              { "offset": 0.6, "color": { "ref": "wine-reflection" }, "opacity": 0 },
              { "offset": 1, "color": { "ref": "wine-reflection" }, "opacity": 0 }
            ]
          }
        }
      ]
    },
