      { "family": "xychart", "target": "axis-title", "style": { "fill": { "ref": "muted-ink" }, "typography": { "font_size_px": 13, "font_weight": 600 } } },
      { "family": "xychart", "target": "axis-label", "style": { "fill": { "ref": "muted-ink" }, "typography": { "font_size_px": 12 } } },
      { "family": "xychart", "target": "legend", "style": { "fill": { "ref": "muted-ink" }, "typography": { "font_size_px": 13 } } },
      { "family": "pie", "target": "pie-slice", "style": { "stroke": { "paint": { "ref": "outline" } } } },
      { "family": "pie", "target": "text", "style": { "fill": { "ref": "ink" }, "typography": { "font_size_px": 15, "font_weight": 600 } } },
