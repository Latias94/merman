{
  "schema_version": 1,
  "kind": "design",
  "design": {
    "tokens": {
      "canvas": { "type": "color", "label": "Midnight concourse", "group": "Wayfinding colors", "value": "#071B2C" },
      "panel": { "type": "color", "label": "Recessed route panel", "group": "Wayfinding colors", "value": "#122B42" },
      "yellow": { "type": "color", "label": "Station sign yellow", "group": "Wayfinding colors", "description": "Shared by primary station plaques, route arrows, activation borders, and the first data series.", "value": "#FFE347" },
      "cyan": { "type": "color", "label": "Cyan interchange", "group": "Wayfinding colors", "description": "A secondary station color and the reference route. Colors follow occurrence order rather than encoding a workflow state.", "value": "#63DCE5" },
      "white": { "type": "color", "label": "Warm white sign face", "group": "Wayfinding colors", "description": "Shared by unfiltered supporting text and alternate station plaques. Flowchart edge-label foreground inherits shared Text.", "value": "#F4F3E9" },
      "muted": { "type": "color", "label": "Secondary timetable text", "group": "Wayfinding colors", "value": "#B4CBD8" },
      "rule": { "type": "color", "label": "Panel divider", "group": "Wayfinding colors", "value": "#4B6B81" },
      "orange": { "type": "color", "label": "Orange route", "group": "Wayfinding colors", "value": "#FFAB64" },
      "green": { "type": "color", "label": "Green route", "group": "Wayfinding colors", "value": "#ACD8A1" },
      "body-font": { "type": "font-stack", "label": "Public information lettering", "group": "Typography", "value": ["Helvetica Neue", "Arial", "Noto Sans CJK SC", "sans-serif"] },
      "sign-font": { "type": "font-stack", "label": "Condensed chart lettering", "group": "Typography", "description": "Compact wayfinding lettering keeps chart headings and route legends distinct from the Helvetica station plaques without rewriting source labels.", "value": ["Avenir Next Condensed", "Arial Narrow", "Helvetica Neue", "Arial", "Noto Sans CJK SC", "sans-serif"] },
      "series": { "type": "palette", "label": "Transit routes", "group": "Palettes", "value": [{ "ref": "yellow" }, { "ref": "cyan" }, { "ref": "orange" }, { "ref": "green" }, "#D8B7EB", { "ref": "white" }] },
      "pie-series": { "type": "palette", "label": "Light route sectors", "group": "Palettes", "description": "All sector colors preserve dark percentage-label contrast; navy separators keep adjacent routes distinct.", "value": [{ "ref": "yellow" }, { "ref": "cyan" }, { "ref": "white" }, { "ref": "orange" }, { "ref": "green" }, "#D8B7EB"] }
    },
    "canvas": {
      "base": { "kind": "solid", "color": { "ref": "canvas" } }
    },
    "typography": {
      "default": { "font_stack": { "ref": "body-font" } },
      "families": {
        "flowchart": { "font_stack": { "ref": "body-font" }, "font_size_px": 16 },
        "sequence": { "font_stack": { "ref": "body-font" }, "font_size_px": 14 },
        "class": { "font_stack": { "ref": "body-font" }, "font_size_px": 14 },
        "xychart": { "font_stack": { "ref": "sign-font" } },
        "pie": { "font_stack": { "ref": "sign-font" } }
      }
    },
    "styles": {
      "text": { "fill": { "kind": "solid", "color": { "ref": "white" } } }
    },
    "rules": [
      { "family": "flowchart", "target": "node", "style": { "fill": { "kind": "solid", "color": { "ref": "yellow" } }, "stroke": { "paint": { "kind": "solid", "color": { "ref": "canvas" } }, "width": 1.2 }, "radius": 0, "effect": null } },
      { "family": "flowchart", "target": "node", "ordinal": { "cycle": { "period": 3, "offset": 1 } }, "style": { "fill": { "kind": "solid", "color": { "ref": "white" } } } },
      { "family": "flowchart", "target": "node", "ordinal": { "cycle": { "period": 3, "offset": 2 } }, "style": { "fill": { "kind": "solid", "color": { "ref": "cyan" } } } },
      { "family": "flowchart", "target": "node-label", "style": { "fill": { "kind": "solid", "color": { "ref": "canvas" } }, "typography": { "font_weight": 700 }, "effect": null } },
      { "family": "flowchart", "target": "edge", "style": { "stroke": { "paint": { "kind": "solid", "color": { "ref": "yellow" } }, "width": 3 }, "effect": null } },
      { "family": "flowchart", "target": "edge-label", "style": { "typography": { "font_stack": { "ref": "body-font" }, "font_size_px": 12, "font_weight": 700 }, "effect": null } },
      { "family": "flowchart", "target": "edge-label-background", "style": { "fill": { "kind": "solid", "color": { "ref": "panel" } } } },
      { "family": "flowchart", "target": "cluster", "style": { "fill": { "kind": "solid", "color": { "ref": "panel" } }, "stroke": { "paint": { "kind": "solid", "color": { "ref": "rule" } }, "width": 1 } } },
      { "family": "flowchart", "target": "cluster-label", "style": { "fill": { "kind": "solid", "color": { "ref": "white" } } } },
      { "family": "sequence", "target": "actor", "style": { "fill": { "kind": "solid", "color": { "ref": "yellow" } }, "stroke": { "paint": { "kind": "solid", "color": { "ref": "yellow" } }, "width": 1 }, "radius": 0, "effect": null } },
      { "family": "sequence", "target": "actor-label", "style": { "fill": { "kind": "solid", "color": { "ref": "canvas" } }, "typography": { "font_stack": { "ref": "body-font" }, "font_size_px": 18, "font_weight": 700 }, "effect": null } },
      { "family": "sequence", "target": "lifeline", "style": { "stroke": { "paint": { "kind": "solid", "color": { "ref": "cyan" } }, "width": 1.5 }, "effect": null } },
      { "family": "sequence", "target": "message", "style": { "stroke": { "paint": { "kind": "solid", "color": { "ref": "yellow" } }, "width": 2.4 }, "effect": null } },
      { "family": "sequence", "target": "message-label", "style": { "fill": { "kind": "solid", "color": { "ref": "white" } }, "typography": { "font_size_px": 13, "font_weight": 500 } } },
      { "family": "sequence", "target": "note", "style": { "fill": { "kind": "solid", "color": { "ref": "white" } }, "stroke": { "paint": { "kind": "solid", "color": { "ref": "white" } }, "width": 1 }, "radius": 0, "effect": null } },
      { "family": "sequence", "target": "note-label", "style": { "fill": { "kind": "solid", "color": { "ref": "canvas" } }, "typography": { "font_size_px": 13, "font_weight": 500, "font_style": "normal" }, "effect": null } },
      { "family": "sequence", "target": "activation", "style": { "fill": { "kind": "solid", "color": { "ref": "cyan" } }, "stroke": { "paint": { "kind": "solid", "color": { "ref": "yellow" } }, "width": 1 }, "effect": null } },
      { "family": "sequence", "target": "loop", "style": { "stroke": { "paint": { "kind": "solid", "color": { "ref": "rule" } }, "width": 1 }, "effect": null } },
      { "family": "sequence", "target": "loop-label-background", "style": { "fill": { "kind": "solid", "color": { "ref": "panel" } }, "stroke": { "paint": { "kind": "solid", "color": { "ref": "yellow" } }, "width": 1 } } },
      { "family": "sequence", "target": "loop-label", "style": { "fill": { "kind": "solid", "color": { "ref": "white" } }, "typography": { "font_size_px": 12, "font_weight": 600 }, "effect": null } },
      { "family": "sequence", "target": "sequence-number", "style": { "fill": { "kind": "solid", "color": { "ref": "canvas" } } } },
      { "family": "class", "target": "node", "style": { "fill": { "kind": "solid", "color": { "ref": "white" } }, "stroke": { "paint": { "kind": "solid", "color": { "ref": "canvas" } } } } },
      { "family": "class", "target": "node-label", "style": { "fill": { "kind": "solid", "color": { "ref": "canvas" } } } },
      { "family": "class", "target": "edge", "style": { "stroke": { "paint": { "kind": "solid", "color": { "ref": "yellow" } }, "width": 2.4 } } },
      { "family": "class", "target": "edge-label-background", "style": { "fill": { "kind": "solid", "color": { "ref": "panel" } } } },
      { "family": "class", "target": "cluster", "style": { "fill": { "kind": "solid", "color": { "ref": "panel" } }, "stroke": { "paint": { "kind": "solid", "color": { "ref": "rule" } } } } },
      { "family": "xychart", "target": "axis", "style": { "fill": { "kind": "solid", "color": { "ref": "white" } }, "stroke": { "paint": { "kind": "solid", "color": { "ref": "rule" } } } } },
      { "family": "xychart", "target": "axis-tick", "style": { "stroke": { "paint": { "kind": "solid", "color": { "ref": "rule" } } } } },
      { "family": "xychart", "target": "title", "style": { "fill": { "kind": "solid", "color": { "ref": "yellow" } }, "typography": { "font_size_px": 26, "font_weight": 700 }, "effect": null } },
      { "family": "xychart", "target": "axis-title", "style": { "fill": { "kind": "solid", "color": { "ref": "muted" } }, "typography": { "font_size_px": 14, "font_weight": 600 }, "effect": null } },
      { "family": "xychart", "target": "axis-label", "style": { "fill": { "kind": "solid", "color": { "ref": "white" } }, "typography": { "font_size_px": 12 }, "effect": null } },
      { "family": "xychart", "target": "legend", "style": { "fill": { "kind": "solid", "color": { "ref": "white" } }, "typography": { "font_size_px": 13, "font_weight": 600 }, "effect": null } },
      { "family": "xychart", "target": "chart-series", "variant": "bar", "style": { "stroke": { "width": 0 }, "effect": null } },
      { "family": "xychart", "target": "chart-series", "variant": "line", "style": { "stroke": { "width": 4 }, "effect": null } },
      { "family": "pie", "target": "pie-slice", "style": { "stroke": { "paint": { "kind": "solid", "color": { "ref": "canvas" } } } } },
      { "family": "pie", "target": "text", "style": { "fill": { "kind": "solid", "color": { "ref": "canvas" } }, "typography": { "font_size_px": 17, "font_weight": 700 } } },
      { "family": "pie", "target": "title", "style": { "fill": { "kind": "solid", "color": { "ref": "yellow" } }, "typography": { "font_size_px": 24, "font_weight": 700 } } },
      { "family": "pie", "target": "legend", "style": { "fill": { "kind": "solid", "color": { "ref": "white" } }, "typography": { "font_size_px": 15, "font_weight": 600 } } }
    ],
    "palettes": {
      "chart-series": { "ref": "series" },
      "pie-slice": { "ref": "pie-series" }
    }
  }
}
