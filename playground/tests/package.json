{
  "name": "@merman/playground-browser-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=11.17.0"
  },
  "scripts": {
    "benchmark:corpus": "node run-benchmark-corpus.mjs",
    "install:browsers": "playwright install --with-deps chromium firefox webkit",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "test:smoke": "playwright test --grep @smoke",
    "test:smoke:non-chromium": "playwright test --grep @smoke --project=firefox-smoke --project=webkit-smoke",
    "test:zenuml-isolation": "playwright test benchmark.realm.spec.ts --project=chromium-desktop --project=chromium-mobile",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^22",
    "playwright": "1.61.1",
    "typescript": "5.7.3"
  }
}
