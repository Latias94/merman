{
  "name": "@merman/playground-browser-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=11.17.0"
  },
  "scripts": {
    "benchmark:corpus": "node --experimental-strip-types run-benchmark-corpus.mjs",
    "install:browser:chromium": "playwright install --with-deps chromium",
    "install:browsers": "playwright install --with-deps chromium firefox webkit",
    "oracle:root-viewport": "node --experimental-strip-types run-root-viewport-oracle.mjs",
    "test": "playwright test --project=chromium-desktop",
    "test:desktop": "playwright test --project=chromium-desktop",
    "test:mobile": "playwright test --project=chromium-mobile-interactions",
    "test:smoke:non-chromium": "playwright test --project=firefox-smoke --project=webkit-smoke --project=webkit-mobile-smoke",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^22",
    "playwright": "1.62.1",
    "typescript": "5.7.3"
  }
}
