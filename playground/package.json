{
  "name": "merman-playground",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/verify-dist-wasm.mjs",
    "preview": "vite preview",
    "verify:dist": "node scripts/verify-dist-wasm.mjs",
    "generate:examples": "cargo run -p xtask -- gen-playground-example-catalog",
    "verify:examples": "cargo run -p xtask -- verify-playground-example-catalog",
    "test": "npm run test:browser:typecheck && npm run test:build-graph && npm run test:semantic-tokens && npm run test:mermaid-config && npm run test:runtime && npm run test:mermaid-requirements && npm run test:realm && npm run test:examples && npm run test:benchmark",
    "test:benchmark": "node --test --experimental-strip-types src/benchmark/*.test.ts src/benchmark/realm/*.test.ts",
    "test:build-graph": "node --test scripts/benchmark-build-graph.test.mjs scripts/csp-policy.test.mjs",
    "test:examples": "node --test --experimental-strip-types src/lib/examples.test.ts",
    "test:browser": "npm run build && npm run test:browser:chromium",
    "test:browser:chromium": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "test:browser:smoke": "npm run build && npm run test:browser:smoke:built",
    "test:browser:smoke:built": "playwright test --grep @smoke",
    "test:browser:typecheck": "tsc --noEmit -p tsconfig.playwright.json",
    "test:mermaid-config": "node --test --experimental-strip-types src/lib/mermaid-config.test.ts",
    "test:runtime": "node --test --experimental-strip-types src/runtime/merman.test.ts src/runtime/render-coordinator.test.ts",
    "test:mermaid-requirements": "node --test --experimental-strip-types src/runtime/mermaid-requirements.test.ts",
    "test:realm": "node --test --experimental-strip-types src/runtime/realm/*.test.ts src/runtime/mermaid-realm-controller.test.ts",
    "test:semantic-tokens": "node --test scripts/semantic-tokens.test.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@mermaid-js/layout-elk": "0.2.1",
    "@mermaid-js/mermaid-zenuml": "0.2.2",
    "@mermanjs/web": "file:../platforms/web",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.564.0",
    "mermaid": "11.16.0",
    "monaco-editor": "^0.55.1",
    "react": "^19",
    "react-dom": "^19",
    "react-i18next": "^17.0.8",
    "react-resizable-panels": "^2.1.7",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.15",
    "vite-plugin-wasm": "^3.6.0"
  }
}
