{
  "name": "merman-playground",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=11.17.0"
  },
  "scripts": {
    "build:opaque-realm": "node scripts/build-opaque-realm.mjs",
    "prepare:browser-runtime": "npm run verify:wasm-inputs && npm run build:opaque-realm && npm run verify:opaque-realm",
    "dev": "npm run prepare:browser-runtime && vite",
    "build": "npm run prepare:browser-runtime && npm run build:prepared",
    "build:prepared": "npm run licenses:check && tsc -b && vite build && npm run verify:dist",
    "benchmark:corpus": "npm run build && npm run benchmark:corpus:built -- --full",
    "benchmark:corpus:built": "npm --prefix tests run benchmark:corpus --",
    "preview": "vite preview",
    "verify:dist": "node scripts/verify-dist-wasm.mjs",
    "verify:opaque-realm": "node scripts/verify-opaque-realm.mjs",
    "verify:wasm-inputs": "node ../platforms/web/scripts/verify-wasm-inputs.mjs --package full",
    "measure:editor-artifacts": "node scripts/editor-artifact-measurement/measure.mjs",
    "generate:examples": "cargo run -p xtask -- gen-playground-example-catalog",
    "verify:examples": "cargo run -p xtask -- verify-playground-example-catalog",
    "verify:zenuml-candidate": "node scripts/zenuml-core-candidate-matrix.mjs",
    "verify:zenuml-candidate:online": "node scripts/zenuml-core-candidate-matrix.mjs --online",
    "verify:zenuml-browser-admission": "node scripts/zenuml-browser-admission.mjs",
    "test:zenuml-browser-admission": "node scripts/zenuml-browser-admission.mjs --run",
    "record:zenuml-browser-admission": "node scripts/zenuml-browser-admission.mjs --run --write",
    "verify:dependencies": "npm ls --all && npm --prefix tests ls --all",
    "test": "npm run prepare:browser-runtime && npm run test:prepared",
    "test:prepared": "npm run test:browser:typecheck && npm run test:build-graph && npm run test:csp-policy:prepared && npm run test:editor-worker && npm run test:mermaid-config && npm run test:runtime && npm run test:mermaid-requirements && npm run test:realm && npm run test:examples && npm run test:export && npm run test:benchmark",
    "test:benchmark": "node --test --experimental-strip-types src/benchmark/*.test.ts src/benchmark/realm/*.test.ts",
    "test:build-graph": "node --test scripts/typescript-source-graph.test.mjs scripts/vite-manifest-graph.test.mjs scripts/playground-build-policy.test.mjs scripts/runtime-module-request-policy.test.mjs scripts/opaque-realm-artifact-plan.test.mjs scripts/opaque-realm-artifact-verifier.test.mjs scripts/validation-migration-ledger.test.mjs scripts/benchmark-page-guards.test.mjs scripts/csp-policy.test.mjs scripts/package-entrypoints.test.mjs",
    "test:csp-policy:prepared": "node --test scripts/csp-policy.prepared.test.mjs",
    "test:examples": "node --test --experimental-strip-types src/lib/examples.test.ts",
    "test:editor-worker": "node --test --experimental-strip-types src/editor/protocol.test.ts src/editor/worker-client.test.ts src/editor/worker-runtime.test.ts src/lib/mermaid-language.test.ts",
    "test:editor-artifact-decision": "node --test scripts/editor-artifact-measurement/contract.test.mjs",
    "test:export": "node --test --experimental-strip-types src/lib/png-export-plan.test.ts",
    "test:browser": "npm run build && npm run test:browser:chromium",
    "test:browser:chromium": "npm --prefix tests run test:chromium",
    "test:browser:smoke": "npm run build && npm run test:browser:smoke:built",
    "test:browser:smoke:built": "npm --prefix tests run test:smoke",
    "test:browser:smoke:non-chromium:built": "npm --prefix tests run test:smoke:non-chromium",
    "test:browser:typecheck": "npm --prefix tests run typecheck",
    "test:zenuml-isolation": "npm --prefix tests run test:zenuml-isolation",
    "test:mermaid-config": "node --test --experimental-strip-types src/lib/mermaid-config.test.ts",
    "test:runtime": "node --test --experimental-strip-types src/runtime/merman.test.ts src/runtime/render-coordinator.test.ts src/runtime/render-artifact.test.ts src/runtime/error-projection.test.ts src/runtime/artifact-actions.test.ts src/runtime/presentation-status.test.ts src/store/index.test.ts src/lib/share.test.ts",
    "test:mermaid-requirements": "node --test --experimental-strip-types src/runtime/mermaid-requirements.test.ts src/runtime/external-module-registrar.test.ts",
    "test:realm": "node --test --experimental-strip-types src/runtime/realm/*.test.ts src/runtime/mermaid-realm-controller.test.ts",
    "lint": "eslint .",
    "licenses:check": "node ../scripts/generate-npm-license-report.mjs --package-root playground --output playground/public/THIRD_PARTY_LICENSES/npm-production-dependencies.txt --check",
    "licenses:generate": "node ../scripts/generate-npm-license-report.mjs --package-root playground --output playground/public/THIRD_PARTY_LICENSES/npm-production-dependencies.txt --write"
  },
  "dependencies": {
    "@mermaid-js/layout-elk": "0.2.2",
    "@mermaid-js/layout-tidy-tree": "0.2.2",
    "@mermaid-js/mermaid-zenuml": "0.2.3",
    "@mermanjs/web": "file:../platforms/web/packages/full",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.564.0",
    "mermaid": "11.16.0",
    "monaco-editor": "^0.55.1",
    "react": "^19",
    "react-dom": "^19",
    "react-i18next": "^17.0.8",
    "react-resizable-panels": "^2.1.7",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "@zenuml/core": "3.50.1",
    "brace-expansion": "5.0.9",
    "cytoscape": "3.34.0",
    "dompurify": "3.4.12",
    "ip-address": "10.4.0",
    "minimatch": "10.2.6",
    "tar": "7.5.22",
    "undici": "6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "generate-license-file": "4.2.1",
    "globals": "^17.6.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.1.5",
    "vite-plugin-wasm": "^3.6.0"
  }
}
