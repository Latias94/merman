  },
  "files": [
    "CHANGELOG.md",
    "artifact",
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md",
    "THIRD_PARTY_LICENSES",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT OR Apache-2.0"
