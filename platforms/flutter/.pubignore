# Control the pub.dev package surface independently from .gitignore.

# Dart / Pub
.dart_tool/
doc/
.packages
.pub-cache/
.pub/
*.iml
.idea/
.vscode/

# Build / IDE
*.log
.DS_Store
__pycache__/
*.pyc

# Repository-only release tooling.
/build-native.py
/ffigen.yaml

# CI creates `native/` before publishing. It is intentionally included because
# this file, rather than .gitignore, controls the pub package.
