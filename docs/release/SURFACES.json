      "id": "typst",
      "name": "Typst package and WASM plugin",
      "audience": "Typst users who want Mermaid diagrams rendered through the wasm-minimal-protocol plugin package.",
      "public": true,
      "public_channel": "typst-registry",
      "entry_point": "packages/typst/merman",
      "install": "Use the local package artifact or follow Typst registry submission once the package PR is accepted.",
      "support_level": "manual-registry",
      "dependency_weight": "typst-wasm",
      "capabilities": [
        "typst",
        "wasm-minimal-protocol",
        "render-svg",
        "analysis",
        "layout-cytoscape",
        "layout-elk",
        "abi-2",
        "analyze-json",
        "artifact-provenance",
        "immutable-package-snapshot"
      ],
      "docs": [
        "README.md",
        "capabilities/artifact-profiles-v1.json",
        "docs/release/PACKAGE_SURFACES.md",
        "crates/merman-typst-plugin/wasm-profiles.json",
        "packages/typst/merman/typst.toml"
      ],
      "packages": [
        { "kind": "typst", "name": "merman", "manifest": "packages/typst/merman/typst.toml" },
        { "kind": "crate", "name": "merman-typst-plugin", "manifest": "crates/merman-typst-plugin/Cargo.toml" }
      ],
      "channels": [
        {
          "id": "typst-registry",
          "kind": "typst-registry",
          "declared_state": "manual-registry",
          "release_kinds": ["stable", "prerelease"],
          "workflow": ".github/workflows/ci.yml",
          "credential": "Typst packages repository PR access",
          "blocker": "Registry publication is a manual `typst/packages` PR."
        },
        {
          "id": "crates.io",
          "kind": "crates.io",
          "declared_state": "published",
          "release_kinds": ["stable", "prerelease"],
          "workflow": ".github/workflows/release-crates.yml",
          "workflow_job": "publish",
          "environment": "crates.io",
          "credential": "CARGO_REGISTRY_TOKEN"
        }
      ],
      "gates": [
        "cargo run --locked -p xtask -- verify-typst-profile-constants",
        "cargo run -p xtask -- wasm-size-matrix --surface typst --budget-file docs/release/WASM_SIZE_BUDGETS.json",
        "cargo run --locked -p xtask -- profile-budget check-deps --profile typst-wasm --artifact-profile typst-wasm",
        "cargo run --locked -p xtask -- build-typst-package --profile publish",
        "cargo run --locked -p xtask -- typst-package-smoke --profile publish --skip-wasm-build"
      ]
    }
  ]
